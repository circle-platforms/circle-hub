        ],
        "set": {
          "name": "slot_kind"
        }
      },
      "context": {
        "sets": {
          "slot_kind": [
            "bucket",
            "block"
          ]
        }
      },
      "subject": {
        "slots": {
          "kind": "operator"
        }
      },
      "expect": [
        {
          "verdict": "refute",
          "code": "core.membership.not_in_set"
        }
      ]
    },
    {
      "name": "表示为 exact 时，首尾空白也算不同",
      "table": {
        "schema": "membership@1",
        "origin": "合成样例：发现码的封闭集合",
        "values": [
          "$.slots.findings[*].code"
        ],
        "set": {
          "values": [
            "F-STEP",
            "F-EXPECT",
            "F-DATA"
          ]
        },
        "match": {
          "whitespace": "exact"
        }
      },
      "subject": {
        "slots": {
          "findings": [
            {
              "code": " F-STEP"
            }
          ]
        }
      },
      "expect": [
        {
          "verdict": "refute",
          "code": "core.membership.not_in_set"
        }
      ]
    }
  ]
