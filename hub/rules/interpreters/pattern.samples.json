          "verdict": "support"
        },
        {
          "verdict": "refute",
          "code": "core.pattern.no_match",
          "data": {
            "negate": true
          }
        }
      ]
    },
    {
      "name": "不区分大小写也不匹配",
      "table": {
        "schema": "pattern@1",
        "origin": "合成样例：不区分大小写的编号",
        "language": "regexp",
        "rules": [
          {
            "values": "$.code",
            "pattern": "[a-z]{2}-[0-9]+",
            "flags": "i",
            "samples": {
              "match": [
                "AB-1",
                "ab-2"
              ],
              "reject": [
                "A-1"
              ]
            }
          }
        ]
      },
      "subject": {
        "code": "Q-12"
      },
      "expect": [
        {
          "verdict": "refute",
          "code": "core.pattern.no_match"
        }
      ]
    },
    {
      "name": "规范化后仍不匹配",
      "table": {
        "schema": "pattern@1",
        "origin": "合成样例：先按表示规范化再匹配",
        "language": "regexp",
        "match": {
          "unicode": "nfkc",
          "whitespace": "collapse"
        },
        "rules": [
          {
            "values": "$.title",
            "pattern": "登录 成功",
            "samples": {
              "match": [
                "登录 成功"
