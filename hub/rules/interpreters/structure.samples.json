{
  "interpreter": "structure@1",
  "tables": {
    "items": {
      "schema": "structure@1",
      "origin": "合成样例：用例条目的结构规则",
      "nodes": "$[*]",
      "item": "/id",
      "location": "/location",
      "rules": [
        {
          "fields": [
            {
              "path": "/fields/title",
              "required": true,
              "type": "string"
            },
            {
              "path": "/fields/priority",
              "required": true,
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            {
              "path": "/fields/tags",
              "required": true,
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "required": true
              }
            },
            {
              "path": "/fields/expected",
              "required": true,
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "string",
                "required": true
              }
            }
          ],
          "unique": [
            {
              "key": [
                "/fields/title"
              ],
              "within": "group",
              "group": [
                "/fields/path"
              ]
            }
          ]
        }
      ]
    },
    "tree": {
      "schema": "structure@1",
      "origin": "合成样例：脑图树的结构规则",
      "kind": "/kind",
      "children": "/children",
      "item": "/id",
      "rules": [
        {
          "kinds": [
            "case"
          ],
          "fields": [
            {
              "path": "/text",
              "required": true,
              "type": "string"
            }
          ],
          "children": {
            "min": 1,
            "max": 1,
            "kinds": [
              "expected"
            ]
          }
        },
        {
          "kinds": [
            "case",
            "group"
          ],
          "unique": [
            {
              "key": [
                "/text"
              ],
              "within": "siblings",
              "match": {
                "whitespace": "collapse"
              }
            }
          ]
        }
      ]
    },
    "values": {
      "schema": "structure@1",
      "origin": "合成样例：字段的类型、长度、数值范围和不区分大小写的唯一键",
      "nodes": "$[*]",
      "item": "/id",
      "rules": [
        {
          "fields": [
            {
              "path": "/name",
              "required": true,
              "type": "string",
              "minLength": 2,
              "maxLength": 8
            },
            {
              "path": "/active",
              "type": "boolean"
            },
            {
              "path": "/ratio",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "path": "/meta",
              "type": "object"
            },
            {
              "path": "/note",
              "type": "null"
            },
            {
              "path": "/steps",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              }
            },
            {
              "path": "/limits",
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9
              }
            }
          ],
          "unique": [
            {
              "key": [
                "/name"
              ],
              "within": "all",
              "match": {
                "case": "insensitive"
              }
            }
          ]
        }
      ]
    }
  },
  "positive": [
    {
      "name": "两个合格的用例条目",
      "table": "items",
      "subject": [
        {
          "id": "doc1:n1",
          "location": "src:1111111111111111111111111111111111111111111111111111111111111111/mindmap@1/n1",
          "fields": {
            "path": [
              "登录模块",
              "基本功能"
            ],
            "title": "用例 n1",
            "priority": 1,
            "tags": [
              "功能"
            ],
            "expected": [
              "显示首页"
            ]
          }
        },
        {
          "id": "doc1:n2",
          "location": "src:1111111111111111111111111111111111111111111111111111111111111111/mindmap@1/n2",
          "fields": {
            "path": [
              "登录模块",
              "基本功能"
            ],
            "title": "用例 n2",
            "priority": 3,
            "tags": [
              "功能",
              "冒烟"
            ],
            "expected": [
              "显示首页"
            ]
          }
        }
      ],
      "expect": [
        {
          "verdict": "support",
          "item": "doc1:n1",
          "pointer": "/0"
        },
        {
          "verdict": "support",
          "item": "doc1:n2",
          "pointer": "/1"
        }
      ]
    },
    {
