    {
      "name": "树：用例节点恰有一个期望结果",
      "table": "tree",
      "subject": {
        "id": "root",
        "kind": "group",
        "text": "根",
        "children": [
          {
            "id": "c1",
            "kind": "case",
            "text": "登录成功",
            "children": [
              {
                "id": "e1",
                "kind": "expected",
                "text": "进入首页"
              }
            ]
          },
          {
            "id": "g2",
            "kind": "group",
            "text": "其他"
          }
        ]
      },
      "expect": [
        {
          "verdict": "support",
          "item": "root",
          "pointer": ""
        },
        {
          "verdict": "support",
          "item": "c1",
          "pointer": "/children/0"
        },
        {
          "verdict": "support",
          "item": "g2",
          "pointer": "/children/1"
        }
      ]
    },
    {
      "name": "类型、长度和范围都合格，名称各不相同",
      "table": "values",
      "subject": [
        {
          "id": "a",
          "name": "alpha",
          "active": true,
          "ratio": 0.5,
          "meta": {},
          "note": null,
          "steps": [
            "s1"
          ],
          "limits": [
            1,
            9
          ]
        },
        {
          "id": "b",
          "name": "beta",
          "active": false,
          "ratio": 1,
          "meta": {
            "x": 1
          },
          "note": null,
          "steps": [],
          "limits": []
        }
      ],
      "expect": [
        {
          "verdict": "support",
          "item": "a"
        },
        {
          "verdict": "support",
          "item": "b"
        }
      ]
    }
  ],
