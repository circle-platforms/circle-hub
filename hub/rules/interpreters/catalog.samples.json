  "positive": [
    {
      "name": "命令都与签名一致（含重载、大小写、可选参数、关键字、引号）",
      "table": "commands",
      "subject": {
        "id": "doc1:n7",
        "location": "src:1111111111111111111111111111111111111111111111111111111111111111/mindmap@1/n7",
        "fields": {
          "negative": false,
          "commands": [
            "lab pool add web1 192.0.2.10 8080",
            "lab pool add web2 192.0.2.11 80 50",
            "lab route add 192.0.2.0 255.255.255.0 192.0.2.1",
            "lab route add 2001:db8:: 32 2001:db8::1",
            "lab show build",
            "LAB MODE SET Fast",
            "lab cert load c1 force",
            "lab cert load 'my cert'"
          ]
        }
      },
      "expect": [
        {
          "verdict": "support",
          "item": "doc1:n7",
          "pointer": "/fields/commands/0",
          "tier": "blocking",
          "data": {
            "head": "lab pool add",
            "overload": 1
          }
        },
        {
          "verdict": "support",
          "pointer": "/fields/commands/1"
        },
        {
          "verdict": "support",
          "data": {
            "head": "lab route add",
            "overload": 1
          }
        },
        {
          "verdict": "support",
          "data": {
            "head": "lab route add",
            "overload": 2
          }
        },
        {
          "verdict": "support",
          "data": {
            "head": "lab show build"
          }
        },
        {
          "verdict": "support",
          "data": {
            "head": "lab mode set"
          }
        },
        {
          "verdict": "support",
          "data": {
            "head": "lab cert load"
          }
        },
        {
          "verdict": "support",
          "data": {
            "command": "lab cert load my cert"
          }
        }
      ]
    },
