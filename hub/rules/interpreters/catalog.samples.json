    {
      "name": "陈述带参数：参数符合某个签名才算存在，命令后面多出的词不符合签名就算不存在",
      "table": "claims",
      "subject": {
        "id": "doc1:n7",
        "claims": [
          {
            "command": "lab pool add web1 192.0.2.10 80",
            "present": true
          },
          {
            "command": "lab show build now",
            "present": false
          },
          {
            "command": "lab pool",
            "present": true
          },
          {
            "command": "lab pool add web1 192.0.2.10 70000",
            "present": false
          }
        ]
      },
      "expect": [
        {
          "verdict": "support",
          "pointer": "/claims/0",
          "data": {
            "in_catalog": true,
            "head": "lab pool add"
          }
        },
        {
          "verdict": "support",
          "pointer": "/claims/1",
          "data": {
            "in_catalog": false,
            "head": "lab show build"
          }
        },
        {
          "verdict": "support",
          "pointer": "/claims/2",
          "data": {
            "in_catalog": true
          }
        },
        {
          "verdict": "support",
          "pointer": "/claims/3",
          "data": {
            "in_catalog": false
          }
        }
      ]
    },
