{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "contracts/**/*.ts",
    "hub/**/*.ts",
    "packs/**/*.ts",
    "tests/**/*.ts",
    "tools/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "foundation",
    "references",
    "node_modules",
    "hub/knowledge/testing/frozen/*@*"
  ]
}
