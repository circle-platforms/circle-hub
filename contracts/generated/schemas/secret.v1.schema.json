{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "secret@1"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "entry": {
      "type": "string",
      "pattern": "^secret\\.[a-z][a-z0-9_]{0,63}\\.[a-f0-9]{24}$"
    },
    "digest_rule": {
      "type": "string",
      "enum": [
        "plain",
        "sha512_base64"
      ]
    },
    "length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "consumers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "definition": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^res_[0-7][0-9a-hjkmnp-tv-z]{25}$"
              },
              {
                "type": "string",
                "pattern": "^exe_[0-7][0-9a-hjkmnp-tv-z]{25}$"
              }
            ]
          },
          "item": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "sends_to": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "definition",
          "item",
          "sends_to"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "name",
    "entry",
    "digest_rule",
    "length",
    "consumers"
  ],
  "additionalProperties": false
}
