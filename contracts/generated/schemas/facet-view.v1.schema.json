{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "facet-view@1"
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "build": {
      "type": "object",
      "properties": {
        "build": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "build",
        "root"
      ],
      "additionalProperties": false
    },
    "kind": {
      "type": "string",
      "enum": [
        "definition",
        "behaviour",
        "case",
        "defect",
        "observation"
      ],
      "description": "the kind of the entries counted"
    },
    "by": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,40}$"
      },
      "description": "data fields of the entries; a field that holds a list counts the entry once per element, a missing field is null"
    },
    "rows": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "values": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,40}$"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "count": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "values",
          "count"
        ],
        "additionalProperties": false
      },
      "description": "one row per distinct combination, sorted by the values in code-unit order"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "entries of the kind in the root, whatever the fields"
    },
    "truncated": {
      "type": "boolean"
    },
    "skipped": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "listed sources the producers could not use in this root: the counts do not cover what they would have given"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "product",
    "build",
    "kind",
    "by",
    "rows",
    "total",
    "truncated",
    "skipped",
    "notes"
  ],
  "additionalProperties": false
}
