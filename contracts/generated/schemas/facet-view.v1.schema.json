{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "unversioned": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "root": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "composition": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "build": {
              "type": "null"
            },
            "skipped_sources": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "totals": {
              "type": "object",
              "properties": {
                "entries": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "documents": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "entries",
                "documents"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "root",
            "composition",
            "build",
            "skipped_sources",
            "totals"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "schema": {
      "type": "string",
      "const": "facet-view@1"
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "build": {
      "type": "object",
      "properties": {
        "build": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "build",
        "root"
      ],
      "additionalProperties": false
    },
    "kind": {
      "type": "string",
      "enum": [
        "definition",
        "behaviour",
        "case",
        "defect",
        "observation"
      ],
      "description": "the kind of the entries counted"
    },
    "by": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,40}$"
      },
      "description": "data fields of the entries; a field that holds a list counts the entry once per element, a missing field is null"
    },
    "rows": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "values": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,40}$"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "count": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "unversioned_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "unversioned_root": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "values",
          "count"
        ],
        "additionalProperties": false
      },
      "description": "one row per distinct combination, sorted by the values in code-unit order"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "entries of the kind in the root, whatever the fields"
    },
    "totals": {
      "type": "object",
      "properties": {
        "unversioned_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unversioned_documents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "empty": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,40}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "description": "Entries in the null group of each by field, once per entry per field; includes rows omitted by every truncation limit; zero is explicit"
        }
      },
      "required": [
        "empty"
      ],
      "additionalProperties": false
    },
    "truncated": {
      "type": "boolean"
    },
    "skipped": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "listed sources the producers could not use in this root: the counts do not cover what they would have given"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "product",
    "build",
    "kind",
    "by",
    "rows",
    "total",
    "totals",
    "truncated",
    "skipped",
    "notes"
  ],
  "additionalProperties": false
}
