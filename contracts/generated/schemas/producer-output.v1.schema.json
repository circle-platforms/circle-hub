                          }
                        },
                        "additionalProperties": false
                      },
                      "conflict": {
                        "type": "boolean"
                      },
                      "superseded": {
                        "description": "An inner scope replaced this declaration; retained as provenance only",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "field",
                      "section",
                      "declaration"
                    ],
                    "additionalProperties": false
                  }
                },
                "range": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "parser",
                "selector"
              ],
              "additionalProperties": false
            },
            "description": "the source pieces that warrant the entry, in order"
          },
          "applicability": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "builds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "platforms": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "models": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "components": {
                    "type": "object",
                    "properties": {
                      "with": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "without": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "additionalProperties": false
                  },
                  "memory": {
                    "type": "object",
                    "properties": {
                      "minimum": {
                        "type": "object",
                        "properties": {
                          "bytes": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "inclusive": {
                            "type": "boolean"
                          }
                        },
                        "required": [
