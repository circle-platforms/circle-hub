                },
                "selector": {
                  "type": "string",
                  "minLength": 1
                },
                "applicability": {
                  "description": "Field-specific source provenance, excluded from entry content",
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "enum": [
                          "models",
                          "platforms",
                          "builds",
                          "components",
                          "memory",
                          "licenses",
                          "deployment_forms"
                        ]
                      },
                      "section": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "declaration": {
                        "type": "object",
                        "properties": {
                          "builds": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "platforms": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "models": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "components": {
                            "type": "object",
                            "properties": {
                              "with": {
                                "minItems": 1,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "without": {
                                "minItems": 1,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              }
                            },
                            "additionalProperties": false
                          },
                          "memory": {
                            "type": "object",
                            "properties": {
                              "minimum": {
                                "type": "object",
                                "properties": {
                                  "bytes": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "inclusive": {
                                    "type": "boolean"
                                  }
                                },
                                "required": [
                                  "bytes",
                                  "inclusive"
                                ],
                                "additionalProperties": false
                              },
                              "maximum": {
                                "type": "object",
                                "properties": {
                                  "bytes": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "inclusive": {
                                    "type": "boolean"
                                  }
                                },
                                "required": [
                                  "bytes",
                                  "inclusive"
                                ],
                                "additionalProperties": false
                              },
                              "raw": {
                                "type": "string",
                                "pattern": "\\S"
                              }
                            },
                            "required": [
                              "raw"
                            ],
                            "additionalProperties": false
                          },
                          "licenses": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "deployment_forms": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "inherited": {
