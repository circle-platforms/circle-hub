{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "description": "declared by the producer (K02 F[0], R[3]); the knowledge package checks it against the entry_kind axis one entry at a time, so one wrong entry is refused and reported without losing the rest"
          },
          "path": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\/(?:[^/]+(?:\\/[^/]+)*)?$"
              },
              {
                "type": "null"
              }
            ],
            "description": "where it hangs; null when code cannot place it (it goes to the typed-judgment model)"
          },
          "statement": {
            "type": "string",
            "description": "deterministic canonical statement; it carries everything data says (K02 R[4])"
          },
          "data": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "fragments": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slot": {
                  "description": "which input slot; required when the producer has more than one",
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "source": {
                  "description": "digest of the source inside a list slot (ProducerSlot.sha256); required for a list slot",
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "parser": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]*@(?:0|[1-9][0-9]*)$"
                },
                "selector": {
                  "type": "string",
                  "minLength": 1
                },
                "range": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "parser",
                "selector"
              ],
              "additionalProperties": false
            },
            "description": "the source pieces that warrant the entry, in order"
          },
          "applicability": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "builds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "platforms": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "models": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "path",
          "statement",
          "data",
          "fragments",
          "applicability"
        ],
        "additionalProperties": false
      }
    },
    "unplaced": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fragment": {
            "type": "object",
            "properties": {
              "slot": {
                "description": "which input slot; required when the producer has more than one",
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "source": {
                "description": "digest of the source inside a list slot (ProducerSlot.sha256); required for a list slot",
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "parser": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]*@(?:0|[1-9][0-9]*)$"
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "range": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "parser",
              "selector"
            ],
            "additionalProperties": false
          },
          "section": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "fragment",
          "section",
          "kind",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "entries",
    "warnings"
  ],
  "additionalProperties": false
}
