                      "maximum": {
                        "type": "object",
                        "properties": {
                          "bytes": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "inclusive": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "bytes",
                          "inclusive"
                        ],
                        "additionalProperties": false
                      },
                      "raw": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "raw"
                    ],
                    "additionalProperties": false
                  },
                  "licenses": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "deployment_forms": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "inherited": {
                    "description": "Inherited field codes only; source positions belong to composition provenance",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "models",
                        "platforms",
                        "builds",
                        "components",
                        "memory",
                        "licenses",
                        "deployment_forms"
                      ]
                    }
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "path",
          "statement",
          "data",
          "fragments",
          "applicability"
        ],
        "additionalProperties": false
      }
    },
