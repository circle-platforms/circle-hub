{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run": {
      "type": "string",
      "pattern": "^run_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "result": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "digest of the validation_result record this summarizes"
    },
    "submission": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "the result's submission field, as stored"
    },
    "acceptance": {
      "type": "string",
      "enum": [
        "accepted",
        "not_accepted"
      ]
    },
    "system_input": {
      "type": "boolean",
      "description": "whether the result carries a system-delivery input"
    },
    "statistics": {
      "type": "object",
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "passed",
            "delivered_pending",
            "delivered_unsatisfied",
            "rejected",
            "incomplete",
            "held",
            "awaiting",
            "abandoned"
          ]
        },
        "pending": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "delivered requirements still pending or with an unknown terminal"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "layer": {
                "type": "string",
                "enum": [
                  "static",
                  "dynamic"
                ]
              },
              "terminal": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "pass",
                      "violation",
                      "judgment",
                      "unchecked",
                      "incomplete"
                    ]
                  },
                  {
                    "type": "string",
                    "enum": [
                      "pass",
                      "fail",
                      "no_verdict",
                      "not_run",
                      "incomplete"
                    ]
                  }
                ]
              },
              "unknown": {
                "type": "boolean"
              },
              "count": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "layer",
              "terminal",
              "unknown",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "no_check",
                  "check_error",
                  "timeout",
                  "missing_input",
                  "declared_skip",
                  "not_covered",
                  "awaiting_step",
                  "output_failed",
                  "repair_exhausted",
                  "budget_exhausted",
                  "integrity_unproven"
                ]
              },
              "count": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "count"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "result",
        "pending",
        "checks",
        "blockers"
      ],
      "additionalProperties": false
    },
    "grounds": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 8192,
        "pattern": "^(?:src:[0-9a-f]{64}(?:\\/[a-z][a-z0-9_.-]{0,63}@(?:0|[1-9][0-9]{0,8})\\/(?:[^%/:\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/:\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*(?::(?:0|[1-9][0-9]{0,15})-(?:0|[1-9][0-9]{0,15}))?)?|tree:[0-9a-f]{64}\\/(?:(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*)?(?:@[0-9a-f]{64})?|rec:[0-9a-f]{64}(?:#(?:\\/(?:[^%~/#\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2}|~[01])*)+)?)$",
        "description": "reference a claim rests on: src, tree or rec; a knowledge entry is cited by its tree address"
      },
      "description": "every ground the result names, in the order the result gives them"
    },
    "bound": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "the digests its validity conditions bind, which name the run sources it rests on"
    },
    "unavailable_references": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 8192,
        "pattern": "^(?:src:[0-9a-f]{64}(?:\\/[a-z][a-z0-9_.-]{0,63}@(?:0|[1-9][0-9]{0,8})\\/(?:[^%/:\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/:\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*(?::(?:0|[1-9][0-9]{0,15})-(?:0|[1-9][0-9]{0,15}))?)?|tree:[0-9a-f]{64}\\/(?:(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*)?(?:@[0-9a-f]{64})?|rec:[0-9a-f]{64}(?:#(?:\\/(?:[^%~/#\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2}|~[01])*)+)?)$",
        "description": "reference a claim rests on: src, tree or rec; a knowledge entry is cited by its tree address"
      },
      "description": "the result's unavailable_references: diagnostic identities, not evidence"
    }
  },
  "required": [
    "run",
    "result",
    "submission",
    "acceptance",
    "system_input",
    "statistics",
    "grounds",
    "bound",
    "unavailable_references"
  ],
  "additionalProperties": false
}
