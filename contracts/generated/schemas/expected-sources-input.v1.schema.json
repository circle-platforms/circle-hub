{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "external": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 8192,
                "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9_-]*:[^@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]+(?:@[^\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]+)?$"
              },
              {
                "type": "null"
              }
            ],
            "description": "the external object the source was read from; null for an upload"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string"
          },
          "parser": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*@(?:0|[1-9][0-9]*)$"
          },
          "model": {
            "description": "the parsed model (the structure the parser gives selectors into)"
          },
          "meta": {
            "anyOf": [
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ],
            "description": "what the system pack derived about the external object, such as its title and the folders above it"
          }
        },
        "required": [
          "slot",
          "external",
          "sha256",
          "media_type",
          "parser",
          "model",
          "meta"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "context": {
      "type": "object",
      "properties": {
        "product": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "string",
            "null"
          ]
        },
        "build": {
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "product",
        "line",
        "build",
        "root",
        "parameters"
      ],
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "label": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "properties": {
              "slot": {
                "description": "which input slot; required when the producer has more than one",
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "parser": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]*@(?:0|[1-9][0-9]*)$"
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "range": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "parser",
              "selector"
            ],
            "additionalProperties": false
          },
          "fields": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "label",
          "location",
          "fields"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "inputs",
    "parameters",
    "context",
    "items"
  ],
  "additionalProperties": false
}
