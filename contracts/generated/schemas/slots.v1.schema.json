{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "slots@1"
    },
    "item": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "codes": {
            "description": "allowed claim codes; without it a claim carries none",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "ranks": {
            "description": "allowed ranking levels, strongest first; without it a claim carries none",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "max": {
            "description": "most claims per item (or in the run); default unbounded within the size limit",
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "min": {
            "description": "fewest claims; 0 allows an explicit \"nothing to report\" (an empty list)",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "data": {
            "description": "JSON Schema 2020-12 of SlotClaim.data",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "evidence": {
            "description": "every claim needs a ground or a quotation of its own that resolves",
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "run": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "codes": {
            "description": "allowed claim codes; without it a claim carries none",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "ranks": {
            "description": "allowed ranking levels, strongest first; without it a claim carries none",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "max": {
            "description": "most claims per item (or in the run); default unbounded within the size limit",
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "min": {
            "description": "fewest claims; 0 allows an explicit \"nothing to report\" (an empty list)",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "data": {
            "description": "JSON Schema 2020-12 of SlotClaim.data",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "evidence": {
            "description": "every claim needs a ground or a quotation of its own that resolves",
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "item",
    "run"
  ],
  "additionalProperties": false
}
