                        "pattern": "\\S"
                      },
                      "next_action": {
                        "type": "string",
                        "pattern": "\\S"
                      },
                      "source_value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "path",
                      "reason",
                      "missing",
                      "next_action"
                    ],
                    "additionalProperties": false
                  }
                },
                "address_role": {
                  "description": "Role identifier from the bound published runtime/bed contract, not an inferred core role",
                  "type": "string",
                  "pattern": "\\S"
                },
                "optional": {
                  "description": "The argument may be omitted",
                  "type": "boolean"
                },
                "default": {
                  "description": "Value used when the argument is omitted, as documented by the source",
                  "type": "string"
                },
                "minimum": {
                  "description": "int and port: inclusive lower bound",
                  "type": "number"
                },
                "maximum": {
                  "description": "int and port: inclusive upper bound",
                  "type": "number"
                },
                "minLength": {
                  "description": "string: minimum length in code points",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "maxLength": {
                  "description": "string: maximum length in code points",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "values": {
                  "description": "enum: the allowed values",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "keyword": {
                  "description": "keyword: the literal word; defaults to the parameter name",
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "description": "Descriptive text; descriptive content is excluded when an impact view compares catalog members by syntax",
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false,
              "description": "One typed parameter of a signature. A producer interprets a scalar source limit by that source format and emits generic constraints: an exact numeric value uses equal minimum/maximum, a ceiling uses maximum, a member uses values, a length uses maxLength; raw limit is not guessed by the core"
            },
            "description": "Positional parameters in order"
          },
          "reference": {
