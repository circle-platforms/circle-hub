{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "revision": {
          "description": "the revision of the object, when the system has one",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "artifacts": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
              },
              "media_type": {
                "type": "string",
                "minLength": 3,
                "maxLength": 200
              },
              "text": {
                "description": "stored as UTF-8",
                "type": "string"
              },
              "json": {
                "description": "stored as RFC 8785 canonical JSON"
              },
              "response": {
                "description": "names a stored response itself instead of new bytes",
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
              }
            },
            "required": [
              "name",
              "media_type"
            ],
            "additionalProperties": false
          }
        },
        "complete": {
          "description": "false when the projection saw that the read did not cover the object; it never makes coverage complete",
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "warnings": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "required": [
        "artifacts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "message": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        "warnings": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
