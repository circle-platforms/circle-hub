{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "validation@1"
    },
    "run": {
      "type": "string",
      "pattern": "^run_[0-9a-z]{26}$"
    },
    "submission": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "digest of the submission, the idempotency key together with the run"
    },
    "acceptance": {
      "type": "string",
      "enum": [
        "accepted",
        "not_accepted"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "path": {
            "description": "JSON Pointer into the submission",
            "type": "string"
          },
          "item": {
            "type": "string"
          },
          "requirement": {
            "type": "string"
          },
          "rounds_left": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "request_id": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "rounds": {
      "type": "object",
      "properties": {
        "used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "used",
        "max"
      ],
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "label": {
            "type": "string"
          },
          "location": {
            "type": "string",
            "description": "reference URI of the item in the judged source"
          },
          "partition": {
            "type": "string",
            "enum": [
              "delivered",
              "rejected",
              "quarantined",
              "incomplete"
            ]
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "requirement": {
                  "type": "string"
                },
                "layers": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "layer": {
                            "type": "string",
                            "const": "static"
                          },
                          "terminal": {
                            "type": "string",
                            "enum": [
                              "pass",
                              "violation",
                              "judgment",
                              "unchecked",
                              "incomplete"
                            ]
                          },
                          "code": {
                            "description": "violation code when terminal is violation",
                            "type": "string"
                          },
                          "tier": {
                            "type": "string",
                            "enum": [
                              "blocking",
                              "advisory"
                            ]
                          },
                          "reason": {
                            "description": "why the state is unchecked or incomplete",
                            "type": "string",
                            "enum": [
                              "no_check",
                              "check_error",
                              "timeout",
                              "missing_input",
                              "declared_skip",
                              "not_covered",
                              "awaiting_step",
                              "output_failed",
                              "repair_exhausted",
                              "budget_exhausted",
                              "integrity_unproven"
                            ]
                          }
                        },
                        "required": [
                          "layer",
                          "terminal"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "layer": {
                            "type": "string",
                            "const": "dynamic"
                          },
                          "terminal": {
                            "type": "string",
                            "enum": [
                              "pass",
                              "fail",
                              "no_verdict",
                              "not_run",
                              "incomplete"
                            ]
                          },
                          "code": {
                            "type": "string"
                          },
                          "tier": {
                            "type": "string",
                            "enum": [
                              "blocking",
                              "advisory"
                            ]
                          },
                          "reason": {
                            "type": "string",
                            "enum": [
                              "no_check",
                              "check_error",
                              "timeout",
                              "missing_input",
                              "declared_skip",
                              "not_covered",
                              "awaiting_step",
                              "output_failed",
                              "repair_exhausted",
                              "budget_exhausted",
                              "integrity_unproven"
                            ]
                          }
                        },
                        "required": [
                          "layer",
                          "terminal"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "satisfied",
                    "unsatisfied",
                    "pending"
                  ]
                },
                "unsatisfied_reason": {
                  "type": "string",
                  "enum": [
                    "no_producer",
                    "abandoned",
                    "outcome_mismatch",
                    "independence_unknown"
                  ]
                },
                "attribution": {
                  "description": "only for non-pass terminals that miss the contract's expected outcome",
                  "type": "string",
                  "enum": [
                    "data_gap",
                    "author_input",
                    "producer_error",
                    "transient",
                    "target_side",
                    "unattributed"
                  ]
                },
                "claims": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "item": {
                        "type": "string"
                      },
                      "requirement": {
                        "type": "string"
                      },
                      "statement": {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string"
                          },
                          "verdict": {
                            "type": "string",
                            "enum": [
                              "support",
                              "refute",
                              "unknown",
                              "abstain"
                            ]
                          },
                          "code": {
                            "description": "violation code or finding code",
                            "type": "string"
                          },
                          "data": {
                            "description": "machine-readable parts of the statement",
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {}
                          }
                        },
                        "required": [
                          "text"
                        ],
                        "additionalProperties": false
                      },
                      "qualifier": {
                        "type": "object",
                        "properties": {
                          "nature": {
                            "type": "string",
                            "enum": [
                              "fact",
                              "judgment",
                              "unknown"
                            ]
                          },
                          "provenance": {
                            "type": "string",
                            "enum": [
                              "observed",
                              "projected",
                              "declared",
                              "candidate"
                            ]
                          },
                          "basis_rank": {
                            "type": "string",
                            "enum": [
                              "rule_over_observation",
                              "rule_over_claims",
                              "judgment",
                              "relay"
                            ]
                          },
                          "source_role": {
                            "type": "string",
                            "enum": [
                              "expected",
                              "subject",
                              "artifact_under_verification",
                              "reported_actual",
                              "republished",
                              "hint",
                              "request_text"
                            ]
                          },
                          "marks": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "target_reported",
                                "report_for_dispatch",
                                "local_ops_not_excluded",
                                "human_intervention",
                                "discrimination_not_established",
                                "semantics_unasserted",
                                "unverified_submission",
                                "client_preview",
                                "model_relay",
                                "no_reuse",
                                "author_samples_only",
                                "conditional_on_judgment",
                                "independence_declared",
                                "not_realtime",
                                "partial"
                              ]
                            }
                          },
                          "coverage": {
                            "type": "object",
                            "properties": {
                              "complete": {
                                "type": "boolean"
                              },
                              "examined": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              "total": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              "note": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "complete",
                              "examined"
                            ],
                            "additionalProperties": false
                          },
                          "control": {
                            "type": "string",
                            "enum": [
                              "automatic",
                              "human_takeover"
                            ]
                          },
                          "discriminating_power": {
                            "type": "string",
                            "enum": [
                              "established",
                              "not_established"
                            ]
                          }
                        },
                        "required": [
                          "nature",
                          "provenance",
                          "marks"
                        ],
                        "additionalProperties": false
                      },
                      "grounds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^(src|tree|entry|rec):[0-9a-f]{64}"
                        }
                      },
                      "warrant": {
                        "type": "object",
                        "properties": {
                          "producer": {
                            "type": "string",
                            "enum": [
                              "function",
                              "model",
                              "human"
                            ]
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "independence": {
                            "type": "string",
                            "enum": [
                              "human_non_author",
                              "model_family_declared",
                              "judge_not_author",
                              "not_independent",
                              "unknown"
                            ]
                          }
                        },
                        "required": [
                          "producer",
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      "resolution": {
                        "type": "string",
                        "enum": [
                          "resolved",
                          "ambiguous",
                          "unresolved"
                        ]
                      },
                      "validity": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "valid",
                              "rule_withdrawn",
                              "grounds_withdrawn",
                              "cited_fragment_changed",
                              "credential_unreadable",
                              "premise_failed",
                              "expired",
                              "contradicted"
                            ]
                          },
                          "bound": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            },
                            "description": "digests the claim depends on; a change in any of them voids it"
                          },
                          "expires_at": {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                          },
                          "premises": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "status",
                          "bound",
                          "premises"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "statement",
                      "qualifier",
                      "grounds",
                      "warrant",
                      "validity"
                    ],
                    "additionalProperties": false
                  },
                  "description": "in display order: position, statement, nature and basis rank, qualifier, grounds, producer, resolution, validity"
                }
              },
              "required": [
                "requirement",
                "layers",
                "status",
                "claims"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "item",
          "label",
          "location",
          "partition",
          "requirements"
        ],
        "additionalProperties": false
      },
      "description": "empty when the submission was not accepted"
    },
    "cross_item": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "requirement": {
            "type": "string"
          },
          "statement": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "support",
                  "refute",
                  "unknown",
                  "abstain"
                ]
              },
              "code": {
                "description": "violation code or finding code",
                "type": "string"
              },
              "data": {
                "description": "machine-readable parts of the statement",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          },
          "qualifier": {
            "type": "object",
            "properties": {
              "nature": {
                "type": "string",
                "enum": [
                  "fact",
                  "judgment",
                  "unknown"
                ]
              },
              "provenance": {
                "type": "string",
                "enum": [
                  "observed",
                  "projected",
                  "declared",
                  "candidate"
                ]
              },
              "basis_rank": {
                "type": "string",
                "enum": [
                  "rule_over_observation",
                  "rule_over_claims",
                  "judgment",
                  "relay"
                ]
              },
              "source_role": {
                "type": "string",
                "enum": [
                  "expected",
                  "subject",
                  "artifact_under_verification",
                  "reported_actual",
                  "republished",
                  "hint",
                  "request_text"
                ]
              },
              "marks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "target_reported",
                    "report_for_dispatch",
                    "local_ops_not_excluded",
                    "human_intervention",
                    "discrimination_not_established",
                    "semantics_unasserted",
                    "unverified_submission",
                    "client_preview",
                    "model_relay",
                    "no_reuse",
                    "author_samples_only",
                    "conditional_on_judgment",
                    "independence_declared",
                    "not_realtime",
                    "partial"
                  ]
                }
              },
              "coverage": {
                "type": "object",
                "properties": {
                  "complete": {
                    "type": "boolean"
                  },
                  "examined": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "complete",
                  "examined"
                ],
                "additionalProperties": false
              },
              "control": {
                "type": "string",
                "enum": [
                  "automatic",
                  "human_takeover"
                ]
              },
              "discriminating_power": {
                "type": "string",
                "enum": [
                  "established",
                  "not_established"
                ]
              }
            },
            "required": [
              "nature",
              "provenance",
              "marks"
            ],
            "additionalProperties": false
          },
          "grounds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(src|tree|entry|rec):[0-9a-f]{64}"
            }
          },
          "warrant": {
            "type": "object",
            "properties": {
              "producer": {
                "type": "string",
                "enum": [
                  "function",
                  "model",
                  "human"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "independence": {
                "type": "string",
                "enum": [
                  "human_non_author",
                  "model_family_declared",
                  "judge_not_author",
                  "not_independent",
                  "unknown"
                ]
              }
            },
            "required": [
              "producer",
              "id"
            ],
            "additionalProperties": false
          },
          "resolution": {
            "type": "string",
            "enum": [
              "resolved",
              "ambiguous",
              "unresolved"
            ]
          },
          "validity": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "valid",
                  "rule_withdrawn",
                  "grounds_withdrawn",
                  "cited_fragment_changed",
                  "credential_unreadable",
                  "premise_failed",
                  "expired",
                  "contradicted"
                ]
              },
              "bound": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "description": "digests the claim depends on; a change in any of them voids it"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "premises": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "status",
              "bound",
              "premises"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "statement",
          "qualifier",
          "grounds",
          "warrant",
          "validity"
        ],
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "delivered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rejected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "quarantined": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "incomplete": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknown": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "delivered",
        "rejected",
        "quarantined",
        "incomplete",
        "unknown"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "examined": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "complete",
        "examined"
      ],
      "additionalProperties": false
    },
    "locks": {
      "type": "object",
      "properties": {
        "pack": {
          "type": "string",
          "description": "pack id@version"
        },
        "pack_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "root": {
          "description": "knowledge root digest locked at start_run",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy": {
          "type": "string"
        }
      },
      "required": [
        "pack",
        "pack_digest"
      ],
      "additionalProperties": false
    },
    "trace": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  },
  "required": [
    "schema",
    "run",
    "submission",
    "acceptance",
    "errors",
    "rounds",
    "items",
    "cross_item",
    "counts",
    "coverage",
    "locks",
    "trace"
  ],
  "additionalProperties": false
}
