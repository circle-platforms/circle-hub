{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run": {
      "type": "string",
      "pattern": "^run_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "model": {
      "description": "Legacy model name and exact configuration; may be omitted when an explicit model_identity is supplied or the same observed session reuses the run declaration",
      "type": "string",
      "minLength": 1
    },
    "model_identity": {
      "description": "Explicit model and family identity; if omitted, the current run declaration is reused only for the same observed session; legacy submissions without either stay unknown",
      "type": "object",
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "model_family_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "configuration_reference": {
          "type": "string",
          "maxLength": 8192,
          "pattern": "^(?:src:[0-9a-f]{64}(?:\\/[a-z][a-z0-9_.-]{0,63}@(?:0|[1-9][0-9]{0,8})\\/(?:[^%/:\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/:\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*(?::(?:0|[1-9][0-9]{0,15})-(?:0|[1-9][0-9]{0,15}))?)?|tree:[0-9a-f]{64}\\/(?:(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*)?(?:@[0-9a-f]{64})?|rec:[0-9a-f]{64}(?:#(?:\\/(?:[^%~/#\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2}|~[01])*)+)?)$",
          "description": "reference a claim rests on: src, tree or rec; a knowledge entry is cited by its tree address"
        }
      },
      "required": [
        "model_id",
        "model_family_id"
      ],
      "additionalProperties": false,
      "title": "model-identity@1"
    },
    "items": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "handling": {
                "type": "string",
                "const": "handled"
              },
              "slots": {
                "description": "slot record, validated against the pack slot schema (RunSummary.slots)",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "context": {
                "description": "digest of the context the model used for this item, so unchanged items can be reused",
                "type": "string"
              },
              "reuse": {
                "description": "instead of slots: the Hub record reference start_run offered for this item, to carry the predecessor fragment over; the Hub checks that the item and the cited content are unchanged and reruns the checks",
                "type": "string",
                "maxLength": 8192,
                "pattern": "^(?:rec:[0-9a-f]{64}(?:#(?:\\/(?:[^%~/#\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2}|~[01])*)+)?)$"
              }
            },
            "required": [
              "item",
              "handling"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "handling": {
                "type": "string",
                "const": "skipped"
              },
              "missing": {
                "description": "Explicit remaining work; otherwise the Hub derives the unfinished item from its frozen projection",
                "type": "string",
                "pattern": "\\S"
              },
              "exit": {
                "description": "Optional fully bound intent; the Hub binds the actual request and named recipient",
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "reread",
                      "reconcile",
                      "observe",
                      "request",
                      "rerun",
                      "reevaluate"
                    ]
                  },
                  "request_kind": {
                    "type": "string",
                    "enum": [
                      "clarification",
                      "repair",
                      "disposition",
                      "judgment"
                    ]
                  },
                  "audience": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "hub": {
                            "type": "boolean",
                            "const": true
                          }
                        },
                        "required": [
                          "hub"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "user": {
                            "type": "string",
                            "pattern": "^usr_[0-7][0-9a-hjkmnp-tv-z]{25}$"
                          }
                        },
                        "required": [
                          "user"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "external": {
                            "type": "object",
                            "properties": {
                              "mapping": {
                                "type": "string",
                                "maxLength": 8192,
                                "pattern": "^(?:rec:[0-9a-f]{64}(?:#(?:\\/(?:[^%~/#\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2}|~[01])*)+)?)$"
                              },
                              "identity": {
                                "type": "string",
                                "pattern": "\\S",
                                "description": "External account identity bound by the referenced mapping"
                              }
                            },
                            "required": [
                              "mapping",
                              "identity"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "external"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "due": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                    "description": "Absolute next-execution time or the named request deadline; never inferred when reading history"
                  }
                },
                "required": [
                  "action",
                  "audience",
                  "due"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "action": {
                          "const": "request"
                        }
                      },
                      "required": [
                        "action"
                      ]
                    },
                    "then": {
                      "properties": {
                        "request_kind": {},
                        "audience": {
                          "type": "object",
                          "not": {
                            "required": [
                              "hub"
                            ],
                            "properties": {
                              "hub": {}
                            }
                          }
                        }
                      },
                      "required": [
                        "request_kind"
                      ]
                    },
                    "else": {
                      "properties": {
                        "audience": {
                          "type": "object",
                          "properties": {
                            "hub": {
                              "const": true
                            }
                          },
                          "required": [
                            "hub"
                          ]
                        }
                      },
                      "not": {
                        "required": [
                          "request_kind"
                        ],
                        "properties": {
                          "request_kind": {}
                        }
                      }
                    }
                  }
                ]
              },
              "reason": {
                "type": "string",
                "pattern": "\\S",
                "description": "why the item is skipped (W07 F[2])"
              }
            },
            "required": [
              "item",
              "handling",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "cross_item": {
      "description": "claims over several items; optional",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "nature": {
                "type": "string",
                "const": "fact"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "grounds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 8192,
                  "pattern": "^(?:src:[0-9a-f]{64}(?:\\/[a-z][a-z0-9_.-]{0,63}@(?:0|[1-9][0-9]{0,8})\\/(?:[^%/:\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/:\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*(?::(?:0|[1-9][0-9]{0,15})-(?:0|[1-9][0-9]{0,15}))?)?|tree:[0-9a-f]{64}\\/(?:(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*)?(?:@[0-9a-f]{64})?|rec:[0-9a-f]{64}(?:#(?:\\/(?:[^%~/#\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2}|~[01])*)+)?)$",
                  "description": "reference a claim rests on: src, tree or rec; a knowledge entry is cited by its tree address"
                },
                "description": "a fact needs at least one reference; a knowledge entry is cited by its tree address"
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "rank": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "nature",
              "statement",
              "grounds"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "nature": {
                "type": "string",
                "const": "judgment"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "grounds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 8192,
                  "pattern": "^(?:src:[0-9a-f]{64}(?:\\/[a-z][a-z0-9_.-]{0,63}@(?:0|[1-9][0-9]{0,8})\\/(?:[^%/:\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/:\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*(?::(?:0|[1-9][0-9]{0,15})-(?:0|[1-9][0-9]{0,15}))?)?|tree:[0-9a-f]{64}\\/(?:(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*)?(?:@[0-9a-f]{64})?|rec:[0-9a-f]{64}(?:#(?:\\/(?:[^%~/#\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2}|~[01])*)+)?)$",
                  "description": "reference a claim rests on: src, tree or rec; a knowledge entry is cited by its tree address"
                }
              },
              "premises": {
                "description": "earlier cross_item entries of this submission that this judgment rests on, for example /cross_item/0",
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\/cross_item\\/(?:0|[1-9][0-9]*)$"
                }
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "rank": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "nature",
              "statement",
              "grounds"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "notes": {
      "type": "string"
    },
    "task_outputs": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "output": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "value": {}
        },
        "required": [
          "output",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "interpreter": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*@(?:0|[1-9][0-9]*)$"
          },
          "table": {
            "$ref": "#/$defs/__schema0"
          },
          "samples": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "expect": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "verdict": {
                        "type": "string",
                        "enum": [
                          "support",
                          "refute",
                          "unknown",
                          "abstain"
                        ]
                      },
                      "code": {
                        "type": "string"
                      },
                      "reason": {
                        "type": "string"
                      },
                      "tier": {
                        "type": "string",
                        "enum": [
                          "blocking",
                          "advisory"
                        ]
                      },
                      "item": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "verdict"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "item",
                "expect"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "requirement",
          "interpreter",
          "table",
          "samples"
        ],
        "additionalProperties": false
      }
    },
    "criterion_changes": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "criterion": {
            "type": "string",
            "maxLength": 8192,
            "pattern": "^(?:src:[0-9a-f]{64}(?:\\/[a-z][a-z0-9_.-]{0,63}@(?:0|[1-9][0-9]{0,8})\\/(?:[^%/:\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/:\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*(?::(?:0|[1-9][0-9]{0,15})-(?:0|[1-9][0-9]{0,15}))?)?|tree:[0-9a-f]{64}\\/(?:(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*)?(?:@[0-9a-f]{64})?|rec:[0-9a-f]{64}(?:#(?:\\/(?:[^%~/#\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2}|~[01])*)+)?)$",
            "description": "reference a claim rests on: src, tree or rec; a knowledge entry is cited by its tree address"
          },
          "assertion": {
            "type": "string",
            "pattern": "\\S"
          },
          "old": {
            "type": "string",
            "pattern": "\\S"
          },
          "new": {
            "type": "string",
            "pattern": "\\S"
          },
          "grounds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "reference": {
