{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "SUBMISSION_SCHEMA_VIOLATION",
            "REFERENCE_UNRESOLVED",
            "REFERENCE_AMBIGUOUS",
            "QUOTE_MISMATCH",
            "SOURCE_UNPARSEABLE",
            "SOURCE_UNAVAILABLE",
            "ENVIRONMENT_PERMISSION_UNAVAILABLE",
            "SOURCE_NOT_PERMITTED",
            "IDEMPOTENCY_MISMATCH",
            "IDENTITY_UNMAPPED",
            "RUN_SUPERSEDED",
            "RUN_ABANDONED",
            "CREDENTIAL_IN_UPLOAD",
            "LEASE_UNAVAILABLE",
            "LEASE_EXPIRED",
            "FENCING_STALE",
            "SOURCE_RETRYABLE",
            "SOURCE_INTEGRITY_UNPROVEN",
            "SOURCE_READ_FAILED",
            "SOURCE_READ_LIMIT",
            "SOURCE_REDIRECT_REFUSED",
            "SOURCE_ABSENT",
            "SOURCE_PENDING_REVIEW",
            "EFFECT_NOT_ALLOWED",
            "EFFECT_PARAMETER_OUT_OF_RANGE",
            "EFFECT_RELEASE_UNMET",
            "EFFECT_UNKNOWN_DISPOSED",
            "EFFECT_BUDGET_EXHAUSTED",
            "BOUNDARY_POLICY_DENIED",
            "PACK_POLICY_DENIED",
            "EFFECT_CONTENT_UNVERIFIED",
            "AUDIENCE_VISIBILITY_EXCEEDED",
            "SPACE_CAPACITY_EXCEEDED",
            "SPACE_ENTRY_INVALID",
            "SPACE_CREDENTIALS_DETECTED",
            "SPACE_SEARCH_IN_RUN",
            "SPACE_VERSION_CONFLICT",
            "SPACE_RESULT_GROUNDS_PRIVATE",
            "SPACE_CONTENT_UNINSPECTABLE",
            "SPACE_INDEX_LIMIT",
            "SHARE_UNVERIFIED",
            "SHARE_GROUND_UNRESOLVED",
            "SHARE_QUOTE_MISMATCH",
            "SHARE_PERSONAL_SOURCE",
            "SHARE_UPLOAD_UNSIGNED",
            "SHARE_GROUND_UNREADABLE",
            "SHARE_DUPLICATE",
            "SHARE_CREDENTIALS",
            "RESULT_GROUNDS_UNREADABLE",
            "GROUNDS_WITHDRAWN",
            "PACK_SPACE_DENIED",
            "PACK_PERSONAL_PUBLICATION_DENIED",
            "PACK_PERSONAL_CAPABILITY_DENIED",
            "TEAM_PARSER_REQUIRED",
            "MEMORY_DOCUMENT_LIMIT",
            "MEMORY_SPACE_LIMIT",
            "MEMORY_CREDENTIALS_DETECTED",
            "MEMORY_VERSION_CONFLICT",
            "MEMORY_RUN_FORBIDDEN",
            "MEMORY_TEAM_DISABLED",
            "MEMORY_CURSOR_STALE",
            "SYNC_VERSION_CONFLICT",
            "SYNC_OBJECT_HASH_MISMATCH",
            "SYNC_OBJECT_INVALID",
            "SYNC_OBJECT_MISSING",
            "SYNC_BATCH_LIMIT",
            "SYNC_SESSION_EXPIRED",
            "SYNC_MODE_LOCAL",
            "SYNC_EPOCH_CHANGED",
            "SYNC_RATE_LIMITED",
            "SYNC_PURGE_CONFIRMATION_REQUIRED",
            "GROUNDS_PURGED",
            "CALL_AUTHENTICATION_REQUIRED",
            "CALL_ORIGIN_REFUSED",
            "CALL_METHOD_UNSUPPORTED",
            "CALL_MEDIA_TYPE_UNSUPPORTED",
            "CALL_REQUEST_INVALID",
            "CALL_BUSY",
            "CALL_INTERNAL_UNAVAILABLE",
            "RUN_EXPORT_NOT_READY"
          ]
        },
        "call_error_category": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "invalid_parameters",
                "permission_denied",
                "not_found",
                "occupied",
                "temporarily_unavailable"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "call_error_reason": {
          "type": "string",
          "enum": [
            "actor_disabled",
            "actor_not_active",
            "environment_disabled",
            "environment_unassigned",
            "environment_not_registered",
            "environment_registration_inconsistent",
            "environment_permission_unavailable",
            "lease_held_by_other_account",
            "lease_already_held_by_current_account",
            "lease_missing_for_lineage",
            "lease_expired",
            "lease_released",
            "lease_reader_unavailable",
            "pack_unassigned",
            "knowledge_root_unassigned",
            "system_unassigned",
            "content_read_not_permitted",
            "named_document_run_scope_denied",
            "run_submission_not_owned",
            "environment_registration_incomplete"
          ]
        },
        "call_not_executed": {
          "description": "Only source-proven pre-handler rejection; absence is unknown, never inferred from HTTP status, message or an internal exception",
          "type": "boolean",
          "const": true
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "call_error_category",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false
}
