{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pack": {
      "type": "string",
      "description": "id@version"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "product",
        "workflow",
        "system"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "every name of the product line the pack is bound to; all of them name one line"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "expected",
              "subject",
              "artifact_under_verification",
              "reported_actual",
              "republished",
              "hint",
              "request_text"
            ]
          },
          "description": {
            "type": "string"
          },
          "accepts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "media types, or external object types written system:type"
          },
          "required": {
            "type": "boolean"
          },
          "many": {
            "type": "boolean"
          }
        },
        "required": [
          "slot",
          "role",
          "description",
          "accepts",
          "required",
          "many"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "schema": {
            "description": "JSON Schema 2020-12 of the value, as the pack declares it; absent when the pack declares none",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "name",
          "description",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "static",
                "dynamic"
              ]
            },
            "description": "the judgment layers this requirement is judged on; other layers are not applicable"
          },
          "done_rule": {
            "type": "string",
            "enum": [
              "bookkeeping",
              "gating"
            ]
          },
          "accepted_producer": {
            "type": "string",
            "enum": [
              "fact",
              "judgment",
              "independent_judgment"
            ]
          },
          "observation": {
            "description": "The declared P07 observation contract for the dynamic layer",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*@(?:0|[1-9][0-9]*)$"
          },
          "repair_rounds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "key",
          "name",
          "description",
          "layers",
          "done_rule",
          "accepted_producer",
          "repair_rounds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "pack",
    "id",
    "version",
    "kind",
    "title",
    "description",
    "products",
    "inputs",
    "parameters",
    "requirements"
  ],
  "additionalProperties": false
}
