            },
            "request_id": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "options_coverage": {
              "description": "how many options there are and how many are listed; note says where the rest are (A05 R[1])",
              "type": "object",
              "properties": {
                "complete": {
                  "type": "boolean"
                },
                "examined": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "complete",
                "examined"
              ],
              "additionalProperties": false
            },
            "coverage": {
              "description": "of the lookup the statement rests on",
              "type": "object",
              "properties": {
                "complete": {
                  "type": "boolean"
                },
                "examined": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "complete",
                "examined"
              ],
