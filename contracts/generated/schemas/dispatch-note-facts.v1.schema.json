          "required": [
            "job"
          ],
          "additionalProperties": false
        },
        "operation": {
          "type": "string",
          "enum": [
            "precheck",
            "dispatch",
            "conformance"
          ]
        },
        "phase": {
          "type": "string",
          "description": "Program stage only, never an effect outcome."
        },
        "reservation_recorded": {
          "type": "boolean"
        },
        "worker_settled": {
          "type": "boolean",
          "description": "Only an actually observed job worker state; never a physical effect or successful execution claim."
        },
        "frozen": {
          "type": "boolean",
          "description": "Conservative no-resend control, including protective unknown or missing-receipt states; not a physical effect observation."
        },
        "result": {
          "type": "string",
          "maxLength": 8192,
