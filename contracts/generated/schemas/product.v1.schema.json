{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "product@1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "names": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "every name of the product; each resolves to this line"
    },
    "sync": {
      "type": "object",
      "properties": {
        "start": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "pages read first, for example the index page of a build site"
        },
        "plan": {
          "type": "object",
          "properties": {
            "module": {
              "type": "string",
              "pattern": "^functions\\/[A-Za-z0-9_.\\/-]+\\.ts$"
            },
            "export": {
              "type": "string",
              "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
            }
          },
          "required": [
            "module"
          ],
          "additionalProperties": false,
          "description": "SyncPlanInput -> SyncPlanOutput; walks the pages and lists the builds worth knowing"
        },
        "options": {
          "description": "defaults handed to the plan function, for example whether platform or customer branches are included",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "max_rounds": {
          "description": "rounds of the plan function, default 6",
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_reads": {
          "description": "pages read in one sync, default 300",
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        }
      },
      "required": [
        "start",
        "plan"
      ],
      "additionalProperties": false
    },
    "select_build": {
      "description": "SelectBuildInput -> SelectBuildOutput; without it the newest released build of the line is chosen",
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^functions\\/[A-Za-z0-9_.\\/-]+\\.ts$"
        },
        "export": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        }
      },
      "required": [
        "module"
      ],
      "additionalProperties": false
    },
    "catalogs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*@(?:0|[1-9][0-9]*)$",
            "description": "catalog@major, the name workflow packs require"
          },
          "entry_kind": {
            "type": "string",
            "enum": [
              "definition",
              "behaviour",
              "case",
              "defect",
              "observation"
            ],
            "description": "kind of the knowledge entries that are its members"
          },
          "producer": {
            "description": "only entries this producer of the pack produced are members; every producer of the kind when absent",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "complete": {
            "type": "boolean",
            "description": "declared complete for the scope of the root (C07 R[0]); only then is absence a fact rather than unknown"
          },
          "case_sensitive": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "entry_kind",
          "complete",
          "case_sensitive"
        ],
        "additionalProperties": false
      }
    },
    "producers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "function": {
            "type": "object",
            "properties": {
              "module": {
                "type": "string",
                "pattern": "^functions\\/[A-Za-z0-9_.\\/-]+\\.ts$"
              },
              "export": {
                "type": "string",
                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
              }
            },
            "required": [
              "module"
            ],
            "additionalProperties": false
          },
          "inputs": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "optional": {
                      "type": "boolean"
                    },
                    "many": {
                      "description": "the role holds a list of external objects; the function is called once per batch of them and its outputs are concatenated, so an entry must not depend on another batch",
                      "type": "boolean"
                    },
                    "batch": {
                      "description": "objects per call for a list role, default 50",
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 200
                    }
                  },
                  "required": [
                    "source"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "external": {
                      "type": "string"
                    },
                    "optional": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "external"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "description": "slot name -> where it is read from, for every build whose root is produced"
          },
          "params": {
            "description": "fixed parameters handed to the function",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "title",
          "function",
          "inputs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "id",
    "title",
    "names",
    "catalogs",
    "producers"
  ],
  "additionalProperties": false
}
