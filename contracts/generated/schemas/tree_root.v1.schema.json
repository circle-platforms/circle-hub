{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "product": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "version": {
      "type": "object",
      "properties": {
        "line": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "line",
        "build",
        "family",
        "platform"
      ],
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "build name exactly as listed"
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "description": "which of the product names the build carries"
        },
        "line": {
          "type": "string",
          "minLength": 1,
          "description": "version line the pack assigns to the build, for example 10.4.6"
        },
        "base": {
          "type": "string",
          "minLength": 1,
          "description": "the build whose tree this build uses; equals name when the build has its own tree"
        },
        "platform": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "platform or customer branch; null for the main platform"
        },
        "built_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "released_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ],
          "description": "null while unreleased"
        },
        "sources": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 8192,
                "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9_-]*:[^@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]+(?:@[^\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]+)?$"
              },
              {
                "type": "object",
                "properties": {
                  "list": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "description": "SHA-256 of the canonical JSON array of the listed external ids, as listed: the object that holds them"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20000,
                    "description": "ids listed, repeats included"
                  }
                },
                "required": [
                  "list",
                  "count"
                ],
                "additionalProperties": false
              }
            ]
          },
          "description": "external objects by role; a role that holds a list is kept by reference"
        }
      },
      "required": [
        "name",
        "family",
        "line",
        "base",
        "platform",
        "built_at",
        "released_at",
        "sources"
      ],
      "additionalProperties": false,
      "description": "the build the root was produced for, as the sync listed it (list roles by reference)"
    },
    "root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "digest of the root node"
    },
    "producer": {
      "type": "object",
      "properties": {
        "pack": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,40}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "pack id@version"
        },
        "producers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "function": {
                "type": "object",
                "properties": {
                  "module": {
                    "type": "string",
                    "pattern": "^functions\\/[A-Za-z0-9_.\\/-]+\\.ts$"
                  },
                  "export": {
                    "type": "string",
                    "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                  }
                },
                "required": [
                  "module"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "function"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "pack",
        "version",
        "digest",
        "id",
        "producers"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "producer": {
            "type": "string",
            "minLength": 1
          },
          "slot": {
            "type": "string",
            "minLength": 1
          },
          "external": {
            "type": "string",
            "maxLength": 8192,
            "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9_-]*:[^@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]+(?:@[^\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]+)?$"
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "parser": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*@(?:0|[1-9][0-9]*)$"
          },
          "artifact": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "digest of the source_artifact record that decided the read"
          },
          "read_tier": {
            "type": "string",
            "enum": [
              "model_readable",
              "function_bytes_only",
              "retain_only"
            ]
          },
          "basis": {
            "type": "string",
            "enum": [
              "release_record",
              "device_echo",
              "declared"
            ]
          },
          "decided_by": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "producer",
          "slot",
          "external",
          "revision",
          "sha256",
          "size",
          "media_type",
          "parser",
          "artifact",
          "read_tier",
          "basis",
          "decided_by"
        ],
        "additionalProperties": false
      },
      "description": "every source; with parts, the sources of single slots only (the list sources are in parts.sources)"
    },
    "composition": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 8192,
            "pattern": "^\\/(?:(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*)?$",
            "description": "Knowledge tree path in canonical text, as the Hub writes it (percent escapes kept verbatim); / is the root"
          },
          "entry": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "definition",
              "behaviour",
              "case",
              "defect",
              "observation"
            ]
          },
          "producers": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "description": "the producers of the product pack that gave the entry, sorted; a catalog limited to one producer takes only its entries"
          },
          "fragments": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 8192,
              "pattern": "^(?:src:[0-9a-f]{64}(?:\\/[a-z][a-z0-9_.-]{0,63}@(?:0|[1-9][0-9]{0,8})\\/(?:[^%/:\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/:\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*(?::(?:0|[1-9][0-9]{0,15})-(?:0|[1-9][0-9]{0,15}))?)?)$"
            },
            "description": "canonical src references in the order the producers gave them"
          },
          "basis": {
            "type": "string",
            "enum": [
              "release_record",
              "device_echo",
              "declared"
            ]
          },
          "decided_by": {
            "type": "string",
            "minLength": 1,
            "description": "who decided the source belongs to the version: the product pack id@version"
          },
          "placement": {
            "description": "present when the typed-judgment model chose the position",
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1,
                "description": "exact model version"
              },
              "p": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "probability of the last choice that descended"
              },
              "threshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "the calibrated threshold of the chain"
              },
              "judgments": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "description": "classify action records, root first"
              },
              "note": {
                "type": "string",
                "description": "归类判断：Jev@<exact version>，p=…，只影响位置"
              }
            },
            "required": [
              "model",
              "p",
              "threshold",
              "judgments",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "path",
          "entry",
          "kind",
          "producers",
          "fragments",
          "basis",
          "decided_by"
        ],
        "additionalProperties": false
      },
      "description": "sorted by path, then entry; empty when the rows are in parts"
    },
    "unplaced": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entry": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "definition",
              "behaviour",
              "case",
              "defect",
              "observation"
            ]
          },
          "producers": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "description": "the producers of the product pack that gave the entry, sorted; a catalog limited to one producer takes only its entries"
          },
          "section": {
            "type": "string"
          },
          "fragments": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 8192,
              "pattern": "^(?:src:[0-9a-f]{64}(?:\\/[a-z][a-z0-9_.-]{0,63}@(?:0|[1-9][0-9]{0,8})\\/(?:[^%/:\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/:\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*(?::(?:0|[1-9][0-9]{0,15})-(?:0|[1-9][0-9]{0,15}))?)?)$"
            },
            "description": "every source piece with this content, in the order the producers gave them"
          },
          "basis": {
            "type": "string",
            "enum": [
              "release_record",
              "device_echo",
              "declared"
            ]
          },
          "decided_by": {
            "type": "string",
            "minLength": 1
          },
          "stopped_at": {
            "type": "string",
            "maxLength": 8192,
            "pattern": "^\\/(?:(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*)?$",
            "description": "the node where placement stopped (/ when it never descended)"
          },
          "candidate": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "maxLength": 8192,
                    "pattern": "^\\/(?:(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*)?$",
                    "description": "Knowledge tree path in canonical text, as the Hub writes it (percent escapes kept verbatim); / is the root"
                  },
                  "model": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "p": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "calibrated": {
                    "type": "boolean",
                    "description": "false: the chain has no calibrated threshold, the answer is only a candidate"
                  }
                },
                "required": [
                  "path",
                  "model",
                  "p",
                  "calibrated"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "the model's answer kept as a candidate, when it named a child"
          },
          "judgments": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "note": {
            "type": "string",
            "description": "why it stopped, in Chinese"
          }
        },
        "required": [
          "entry",
          "kind",
          "producers",
          "section",
          "fragments",
          "basis",
          "decided_by",
          "stopped_at",
          "candidate",
          "judgments",
          "note"
        ],
        "additionalProperties": false
      },
      "description": "sorted by entry; empty when the rows are in parts"
    },
    "parts": {
      "description": "a large composition keeps its rows, unplaced rows and list sources in part records, so that no record grows with the root",
      "type": "object",
      "properties": {
        "composition": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "record": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "digest of the part record"
              },
              "rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "first": {
                "type": "string",
                "description": "sort key of the first row: the path (composition rows), the entry digest (unplaced rows) or the source digest (sources)"
              },
              "last": {
                "type": "string",
                "description": "sort key of the last row"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "definition",
                  "behaviour",
                  "case",
                  "defect",
                  "observation"
                ],
                "description": "the kind of every row of the part"
              }
            },
            "required": [
              "record",
              "rows",
              "first",
              "last",
              "kind"
            ],
            "additionalProperties": false
          },
          "description": "tree_root-rows@1 records"
        },
        "unplaced": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "record": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "digest of the part record"
              },
              "rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "first": {
                "type": "string",
                "description": "sort key of the first row: the path (composition rows), the entry digest (unplaced rows) or the source digest (sources)"
              },
              "last": {
                "type": "string",
                "description": "sort key of the last row"
              }
            },
            "required": [
              "record",
              "rows",
              "first",
              "last"
            ],
            "additionalProperties": false
          },
          "description": "tree_root-unplaced@1 records"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "record": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "digest of the part record"
              },
              "rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "first": {
                "type": "string",
                "description": "sort key of the first row: the path (composition rows), the entry digest (unplaced rows) or the source digest (sources)"
              },
              "last": {
                "type": "string",
                "description": "sort key of the last row"
              }
            },
            "required": [
              "record",
              "rows",
              "first",
              "last"
            ],
            "additionalProperties": false
          },
          "description": "tree_root-sources@1 records: the sources of list slots"
        }
      },
      "required": [
        "composition",
        "unplaced",
        "sources"
      ],
      "additionalProperties": false
    },
    "refused": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "producer": {
            "type": "string",
            "minLength": 1
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "unplaced": {
            "type": "boolean",
            "description": "the refused item was an unplaced span rather than an entry"
          },
          "kind": {
            "type": "string",
            "maxLength": 200,
            "description": "the kind the producer declared, as given (cut to 200 characters; may be empty or outside entry_kind)"
          },
          "path": {
            "type": [
              "string",
