{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "identity": {
          "type": "object",
          "properties": {
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "parser": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*@(?:0|[1-9][0-9]*)$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "span": {
              "type": "object",
              "properties": {
                "unit": {
                  "type": "string",
                  "const": "byte"
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "length": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "unit",
                "offset",
                "length"
              ],
              "additionalProperties": false,
              "title": "source-span@1",
              "description": "Zero-based offset and positive length in the original source bytes; the end is exclusive. Hub checks the span against the retained source, not against normalized text."
            }
          },
          "required": [
            "source_sha256",
            "parser",
            "path",
            "span"
          ],
          "additionalProperties": false,
          "title": "expected-quote-identity@1",
          "description": "Immutable identity of an expected quotation: original source digest, parser@major, exact selector and raw byte span. No width, whitespace or synonym folding."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        }
      },
      "required": [
        "identity",
        "text"
      ],
      "additionalProperties": false,
      "title": "quote-evidence@1",
      "description": "Verbatim quote paired with its original-byte identity; presence and item ownership are checked at the Hub boundary."
    },
    {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "maxLength": 8192,
          "pattern": "^(?:src:[0-9a-f]{64}(?:\\/[a-z][a-z0-9_.-]{0,63}@(?:0|[1-9][0-9]{0,8})\\/(?:[^%/:\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/:\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*(?::(?:0|[1-9][0-9]{0,15})-(?:0|[1-9][0-9]{0,15}))?)?)$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        }
      },
      "required": [
        "reference",
        "text"
      ],
      "additionalProperties": false
    }
  ],
  "title": "feeding-quote@1",
  "description": "Feeding uses an exact src selector quotation, as the approved page specifies. Raw-byte QuoteEvidence remains accepted when the parser can prove byte ranges. Missing byte maps are not guessed; no whitespace folding or new content parser is used."
}
