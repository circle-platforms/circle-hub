{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "member-bot-inbound@1"
    },
    "kind": {
      "type": "string",
      "const": "dispatch"
    },
    "request": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "member": {
      "type": "string",
      "pattern": "^usr_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "issuer": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "channel": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "platform_id_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "text_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "text_size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "files": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "name_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "sha256",
          "size",
          "name_sha256"
        ],
        "additionalProperties": false
      }
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "schema",
    "kind",
    "request",
    "member",
    "issuer",
    "subject",
    "channel",
    "platform_id_sha256",
    "text_sha256",
    "text_size",
    "files",
    "at"
  ],
  "additionalProperties": false
}
