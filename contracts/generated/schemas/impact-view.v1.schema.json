{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "unversioned": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "root": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "composition": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "build": {
              "type": "null"
            },
            "skipped_sources": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "totals": {
              "type": "object",
              "properties": {
                "entries": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "documents": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "cut_entries": {
                  "description": "product-wide entries omitted by the links first-page payload budget; repeated unchanged on later pages",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "entries",
                "documents"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "root",
            "composition",
            "build",
            "skipped_sources",
            "totals"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "schema": {
      "type": "string",
      "const": "impact-view@1"
    },
    "scope": {
      "type": "object",
      "properties": {
        "note": {
          "description": "Explicit extent of the document observations, not a claim about every enterprise document",
          "type": "string"
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "root": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "composition": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "build": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "root",
              "composition",
              "build"
            ],
            "additionalProperties": false
          }
        },
        "additional_roots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "root": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "composition": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "build": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "root",
              "composition",
              "build"
            ],
            "additionalProperties": false
          }
        },
        "additional_roots_declared": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean",
          "description": "document membership and omissions are fully enumerated; omitted inputs are outside the computed data"
        },
        "not_in_roots": {
          "description": "Per-composition source exclusions, even when another declared root covers the same document",
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "source observations; versions of one external id are distinguished by composition and byte digest"
            },
            "parts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "reference": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "rows": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "reference",
                  "sha256",
                  "rows"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "total",
            "parts"
          ],
          "additionalProperties": false
        },
        "listed_documents": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "source observations; versions of one external id are distinguished by composition and byte digest"
            },
            "parts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "reference": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "rows": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "reference",
                  "sha256",
                  "rows"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "total",
            "parts"
          ],
          "additionalProperties": false
        },
        "elsewhere_documents": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "source observations; versions of one external id are distinguished by composition and byte digest"
            },
            "parts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "reference": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "rows": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "reference",
                  "sha256",
                  "rows"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "total",
            "parts"
          ],
          "additionalProperties": false
        },
        "omitted_documents": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "source observations; versions of one external id are distinguished by composition and byte digest"
                },
                "parts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "reference": {
                        "type": "string"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "rows": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "reference",
                      "sha256",
                      "rows"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "total",
                "parts"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "pending_documents": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "source observations; versions of one external id are distinguished by composition and byte digest"
            },
            "parts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "reference": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "rows": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "reference",
                  "sha256",
                  "rows"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "total",
            "parts"
          ],
          "additionalProperties": false
        },
        "missing_optional_sources": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "source observations; versions of one external id are distinguished by composition and byte digest"
            },
            "parts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "reference": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "rows": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "reference",
                  "sha256",
                  "rows"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "total",
            "parts"
          ],
          "additionalProperties": false
        },
        "unplaced_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unplaced_cases": {
          "type": "object",
          "properties": {
            "from": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "to": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        "request": {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string"
            },
            "audience_user": {
              "type": "string"
            },
            "deadline": {
              "type": "string"
            },
            "action": {
              "type": "string"
            }
          },
          "required": [
            "reference",
            "audience_user",
            "deadline",
            "action"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "roots",
        "additional_roots",
        "additional_roots_declared",
        "complete",
        "listed_documents",
        "elsewhere_documents",
        "omitted_documents",
        "pending_documents",
        "missing_optional_sources",
        "unplaced_entries"
      ],
      "additionalProperties": false
    },
    "next": {
      "description": "Continuation for the same immutable scope; null on the last page",
      "type": [
        "string",
        "null"
      ]
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "from": {
      "type": "object",
      "properties": {
        "build": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "build",
        "root"
      ],
      "additionalProperties": false
    },
    "to": {
      "type": "object",
      "properties": {
        "build": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "build",
        "root"
      ],
      "additionalProperties": false
    },
    "changed_kinds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "definition",
          "behaviour",
          "case",
          "defect",
          "observation",
          "procedure",
          "pitfall"
        ]
      },
      "description": "the entry kinds whose difference counts as a change; default definition and behaviour; with catalog, the single kind of the catalog members"
    },
    "attached_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "definition",
          "behaviour",
          "case",
          "defect",
          "observation",
          "procedure",
          "pitfall"
        ]
      },
      "description": "the entry kinds listed on the changed nodes; default case"
    },
    "attached_fields": {
      "description": "the request asked for only these data fields per attached entry: they carry them with an empty statement; absent means full entries (the changed entries are never slimmed)",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,40}$"
      }
    },
    "catalog": {
      "description": "the request filtered the changes to the members of this catalog, read per root from the declaration of the product and compared by syntax (catalog-entry@1 without the descriptive fields, references and signature ids); absent: no catalog, every entry of the changed kinds counts",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*@(?:0|[1-9][0-9]*)$"
    },
    "changes": {
      "maxItems": 200000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 8192,
            "pattern": "^\\/(?:(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*)?$",
            "description": "Knowledge tree path in canonical text, as the Hub writes it (percent escapes kept verbatim); / is the root"
          },
          "change": {
            "type": "string",
            "enum": [
              "added",
              "removed",
              "modified"
            ],
            "description": "added: only in the later root; removed: only in the earlier; modified: in both with different entries"
          },
          "before": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "description": "digests of its entries of the changed kinds in the earlier root; empty when added"
          },
          "after": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "description": "the same in the later root; empty when removed"
          }
        },
        "required": [
          "path",
          "change",
          "before",
          "after"
        ],
        "additionalProperties": false
      }
    },
    "placements": {
      "maxItems": 200000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 8192,
            "pattern": "^\\/(?:(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*)?$",
            "description": "Knowledge tree path in canonical text, as the Hub writes it (percent escapes kept verbatim); / is the root"
          },
          "from": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "description": "digests of the attached entries at this node in the earlier root"
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "description": "the same in the later root"
          }
        },
        "required": [
          "path",
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "description": "only nodes that hold at least one attached entry"
    },
    "entries": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "build": {
            "type": "null"
          },
          "entry": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "definition",
              "behaviour",
              "case",
              "defect",
              "observation",
              "procedure",
              "pitfall"
            ]
          },
          "statement": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "reference": {
            "type": "string",
            "maxLength": 8192,
            "pattern": "^(?:tree:[0-9a-f]{64}\\/(?:(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+(?:\\/(?:[^%/@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]|%[0-9A-F]{2})+)*)?(?:@[0-9a-f]{64})?)$",
            "description": "tree:<root><path>@<entry>, citable as a ground"
          }
        },
        "required": [
          "entry",
          "kind",
          "statement",
          "data",
          "reference"
        ],
        "additionalProperties": false
      },
      "description": "every entry named above by digest, once; the references in it are those of the later root, or of the earlier one for an entry that exists only there"
    },
    "totals": {
      "type": "object",
      "properties": {
        "unversioned_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unversioned_documents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "changed_paths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attached_from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attached_to": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "changed_paths",
        "attached_from",
        "attached_to"
      ],
      "additionalProperties": false
    },
    "truncated": {
      "type": "boolean",
      "description": "true when a limit cut the lists; totals still count everything"
    },
    "skipped": {
      "type": "object",
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "to": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "description": "listed sources the producers could not use per side: the build root on that side plus the shared locked product-wide root; the shared count intentionally contributes to both sides; the produced entries do not cover these sources"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "what the reader could not say, in Chinese: a root without entries of the attached kind, a cut list"
    }
  },
  "required": [
    "schema",
    "product",
    "from",
    "to",
    "changed_kinds",
    "attached_kinds",
    "changes",
    "placements",
    "entries",
    "totals",
    "truncated",
    "skipped",
    "notes"
  ],
  "additionalProperties": false
}
