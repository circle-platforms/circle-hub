{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "member": {
      "type": "string",
      "pattern": "^usr_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "by": {
      "type": "string",
      "pattern": "^usr_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "epoch": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "purge_manifest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "properties": {
        "records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "payloads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "objects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attributions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "archives": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "private_versions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "records",
        "payloads",
        "objects",
        "attributions",
        "archives",
        "private_versions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "operation_id",
    "member",
    "by",
    "at",
    "epoch",
    "purge_manifest",
    "counts"
  ],
  "additionalProperties": false
}
