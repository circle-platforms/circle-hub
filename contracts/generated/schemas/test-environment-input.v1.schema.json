{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "prefixes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prefix": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:._/-]{0,199}$"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^usr_[0-7][0-9a-hjkmnp-tv-z]{25}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "registered_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "prefix",
          "owner",
          "registered_at"
        ],
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:._/-]{0,199}$"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^usr_[0-7][0-9a-hjkmnp-tv-z]{25}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "registered_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "owner",
          "registered_at"
        ],
        "additionalProperties": false
      }
    },
    "executors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^exe_[0-7][0-9a-hjkmnp-tv-z]{25}$"
      }
    },
    "enabled": {
      "type": "boolean"
    },
    "missing_facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "name",
    "target",
    "prefixes",
    "resources",
    "executors",
    "enabled",
    "missing_facts"
  ],
  "additionalProperties": false
}
