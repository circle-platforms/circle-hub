{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "external": {
                "type": "string",
                "maxLength": 8192,
                "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9_-]*:[^@\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]+(?:@[^\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u2064\\u2066-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB]+)?$"
              },
              "role": {
                "type": "string",
                "enum": [
                  "expected",
                  "hint"
                ]
              },
              "reason": {
                "type": "string",
                "description": "why this source was bound, in Chinese"
              }
            },
            "required": [
              "external",
              "role",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string"
              },
              "document": {
                "type": "string"
              },
              "item": {
                "type": "string"
              },
              "node": {
                "type": "string"
              },
              "data": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sources",
        "warnings"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "fix": {
              "type": "string"
            },
            "documents": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pointer": {
              "description": "where in this call the problem is, under /parameters or /inputs (decision 114); absent: the judged input",
              "type": "string",
              "maxLength": 8192,
              "pattern": "^(?:\\/(?:[^~/]|~[01])*)*$"
            },
            "grounds": {
              "description": "references and external ids the error rests on",
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "warrant": {
              "description": "the rule or component that decided it, as id@version",
              "type": "string",
              "minLength": 1
            },
            "provenance": {
              "description": "declared, observed or projected (A02)",
              "type": "string",
              "enum": [
                "observed",
                "projected",
                "declared",
                "candidate",
                "client_captured"
              ]
            },
            "collected_at": {
              "description": "when the facts it rests on were read; an observation holds only for that moment (A05 R[3])",
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "missing": {
              "description": "the missing fact, written instead of a next step nobody can take",
              "type": "string",
              "minLength": 1
            },
            "hypotheses": {
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "prediction": {
                    "type": "string"
                  },
                  "support": {
                    "description": "observations and references that agree with the hypothesis",
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "refute": {
                    "description": "observations and references that disagree with it",
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "open",
                      "excluded"
                    ]
                  }
                },
                "required": [
                  "statement",
                  "status"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "code",
            "message",
            "fix"
          ],
          "additionalProperties": false
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string"
              },
              "document": {
                "type": "string"
              },
              "item": {
                "type": "string"
              },
              "node": {
                "type": "string"
              },
              "data": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "error",
        "warnings"
      ],
      "additionalProperties": false
    }
  ]
}
