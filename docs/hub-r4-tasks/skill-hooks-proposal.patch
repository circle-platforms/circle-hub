+test('the hook file is listed at the pack root and a staged pack carries it beside SKILL.md, byte for byte', async () => {
+  const listed = (await computeManifest()).files.map((entry) => entry.path);
+  assert.ok(listed.includes('hooks.json') && listed.includes('SKILL.md'));
+  assert.ok(!listed.some((path) => path.endsWith('/hooks.json')), 'one hook file, at the root');
+  const target = mkdtempSync(join(tmpdir(), 'cc-stage-'));
+  try {
+    await stage(target);
+    const folder = readdirSync(target);
+    assert.ok(folder.includes('hooks.json') && folder.includes('SKILL.md'), folder.join(','));
+    assert.deepEqual(readFileSync(join(target, 'hooks.json')), readFileSync(join(PACK_DIR, 'hooks.json')));
+  } finally {
+    rmSync(target, { recursive: true, force: true });
+  }
+});
