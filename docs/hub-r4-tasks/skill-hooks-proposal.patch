diff --git a/contracts/src/pack.ts b/contracts/src/pack.ts
index 2e29948f1d..4a810ee602 100644
--- a/contracts/src/pack.ts
+++ b/contracts/src/pack.ts
@@ -138,0 +139,31 @@ export type PackManifest = z.infer<typeof PackManifest>;
+
+
+export const SKILL_HOOKS_FILE = 'hooks.json';
+
+
+export function mayShipSkillHooks(kind: PackKind): boolean {
+  return (REQUIRED_FILES[kind] as readonly string[]).includes('SKILL.md');
+}
+
+
+export const SKILL_HOOK_COMMAND_MAX = 4000;
+const SkillHook = z.object({
+  command: z
+    .string()
+    .max(SKILL_HOOK_COMMAND_MAX)
+    .refine((v) => v.trim() !== '', 'a hook has a command')
+    .refine((v) => !v.includes('\0'), 'a command has no NUL character'),
+});
+const SkillHookList = z.array(SkillHook).optional();
+export const SkillHooksFile = z.object({
+  version: z.literal(1),
+  hooks: z.strictObject({
+    before_tool: SkillHookList,
+    after_tool: SkillHookList,
+    before_stop: SkillHookList,
+    session_start: SkillHookList,
+    permission_request: SkillHookList,
+  }),
+});
+export type SkillHooksFile = z.infer<typeof SkillHooksFile>;
+
