+test('the skill ships its own hook file, and it refuses a question from a session that is not a lead of its workspace, and nothing else', () => {
+  const file = JSON.parse(read('hooks.json')) as { version: number; hooks: Record<string, Array<{ name: string; tools?: string; command: string }>> };
+  assert.ok(SkillHooksFile.safeParse(file).success, 'the Hub reads the file as the client does when the pack is published');
+  assert.equal(file.version, 1);
+  assert.deepEqual(Object.keys(file.hooks).sort(), ['before_tool', 'session_start']);
+  const [start] = file.hooks.session_start, [ask] = file.hooks.before_tool;
+  assert.equal(file.hooks.session_start.length + file.hooks.before_tool.length, 2);
+  assert.equal(ask.tools, 'question');
+  const notes = mkdtempSync(join(tmpdir(), 'cc-hooks-'));
+  try {
+    const env = { ...process.env, TMPDIR: notes, PATH: `${dirname(process.execPath)}${delimiter}${process.env.PATH ?? ''}` };
+    const call = (command: string, input: unknown) => spawnSync(command, { shell: true, input: typeof input === 'string' ? input : JSON.stringify(input), encoding: 'utf8', env });
+    const asked = (session: string, cwd: string, tool = 'question') => {
+      const done = call(ask.command, { event: 'before_tool', session_id: session, cwd, tool_name: tool, tool_input: {} });
+      assert.equal(done.status, 0, done.stderr);
+      return JSON.parse(done.stdout);
+    };
+    assert.deepEqual(asked('sub-1', '/synthetic/work-a'), {});
+    assert.equal(call(start.command, { event: 'session_start', session_id: 'lead-1', cwd: '/synthetic/work-a' }).status, 0);
+    assert.deepEqual(asked('lead-1', '/synthetic/work-a'), {}, 'the session that loaded the skill asks');
+    const refused = asked('sub-1', '/synthetic/work-a');
+    assert.equal(refused.decision, 'deny');
+    assert.match(refused.reason, /^子代理不向用户提问：.*交回派给你任务的主代理。$/);
+    assert.deepEqual(asked('sub-1', '/synthetic/work-a', 'read_file'), {}, 'only the question tool');
+    assert.deepEqual(asked('sub-1', '/synthetic/work-b'), {}, 'another workspace has its own note');
+    assert.equal(call(start.command, { event: 'session_start', session_id: 'lead-2', cwd: '/synthetic/work-a' }).status, 0);
+    assert.equal(call(start.command, { event: 'session_start', session_id: '../x', cwd: '/synthetic/work-a' }).status, 0);
+    assert.deepEqual([asked('lead-2', '/synthetic/work-a'), asked('../x', '/synthetic/work-a').decision], [{}, 'deny']);
+    for (const input of ['not json', {}, { event: 'before_tool', tool_name: 'question' }]) {
+      const done = call(ask.command, input);
+      assert.equal(done.status, 0);
+      assert.deepEqual(JSON.parse(done.stdout), {});
+    }
+    for (const hook of [start, ask]) assert.ok(hook.command.length <= 4000 && !hook.command.includes('\n'), hook.name);
+  } finally {
+    rmSync(notes, { recursive: true, force: true });
+  }
+});
