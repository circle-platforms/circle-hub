{
  "name": "circle-hub",
  "version": "0.2.0",
  "private": true,
  "description": "circle-hub: the team hub for Circle - shared knowledge, durable tasks, governed execution and versioned methods",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/circle-platforms/circle-hub.git"
  },
  "homepage": "https://circle-platforms.github.io/circle-hub/",
  "bin": {
    "circle-hub": "apps/server/src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true,
    "@embedded-postgres/darwin-x64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-arm@18.4.0-beta.17": true,
    "@embedded-postgres/linux-arm64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-ia32@18.4.0-beta.17": true,
    "@embedded-postgres/linux-ppc64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  },
  "scripts": {
    "verify:references": "node tools/verify-reference-archive.ts",
    "test:references": "node --test tools/verify-reference-archive.test.ts",
    "test:contracts": "node --test tests/contracts/*.test.ts",
    "test:methods": "node --test tests/methods/*.test.ts",
    "test:acceptance": "node --test --test-concurrency=1 tests/acceptance/*.test.ts",
    "test": "npm run test:contracts && npm run test:methods && npm run test:acceptance && npm run test:references",
    "typecheck": "tsc --noEmit",
    "server": "node apps/server/src/supervisor.ts",
    "admin": "node apps/server/src/cli.ts admin",
    "worker": "node apps/worker/src/main.ts",
    "verify:postgres": "node scripts/verify-postgres.ts",
    "dev:stack": "node scripts/dev-stack.ts",
    "runtime:profile": "node scripts/runtime-profile.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "parse5": "8.0.1",
    "pg": "8.23.1",
    "read-excel-file": "9.3.12",
    "saxes": "5.0.1",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
