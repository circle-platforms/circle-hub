{
  "name": "circle-hub",
  "version": "0.2.0",
  "private": true,
  "description": "circle-hub: the team hub for Circle - task packs, verified results and a knowledge tree over standard MCP",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/circle-platforms/circle-hub.git"
  },
  "homepage": "https://circle-platforms.github.io/circle-hub/",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verify:references": "node tools/verify-reference-archive.ts",
    "test:references": "node --test tools/verify-reference-archive.test.ts",
    "gen:contracts": "node tools/gen-contracts.ts",
    "verify:contracts": "node tools/gen-contracts.ts --check",
    "test:unit": "node tools/run-unit-tests.ts",
    "test:acceptance": "node --test --test-concurrency=1 \"tests/acceptance/*.test.ts\"",
    "test:docs": "node --test \".github/checks/*.test.ts\"",
    "test": "npm run verify:contracts && npm run test:unit && npm run test:docs && npm run test:acceptance && npm run test:references",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "koffi": "3.3.3",
    "parse5": "8.0.1",
    "pg": "8.23.1",
    "read-excel-file": "9.3.12",
    "saxes": "5.0.1",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
