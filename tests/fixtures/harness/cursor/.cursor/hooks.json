{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "sh scripts/verify-command.sh",
        "timeout": 10
      }
    ],
    "sessionStart": [
      {
        "command": "sh scripts/boot.sh"
      },
      {
        "type": "prompt",
        "prompt": "synthetic prompt text"
      }
    ]
  }
}
