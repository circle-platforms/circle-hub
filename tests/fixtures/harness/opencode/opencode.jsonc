{
  // Synthetic OpenCode config.
  "mcp": {
    "servers": {
      "local-runner": {
        "type": "local",
        "command": [
          "node",
          "server.js"
        ],
        "environment": { "RUNNER_TOKEN": "synthetic-opencode-token" },
      },
      "remote-hub": {
        "type": "remote",
        "url": "https://mcp.example.com/opencode",
        "headers": { "Authorization": "Bearer synthetic-opencode-header" }
      }
    }
  }
}
