{
  "mcpServers": {
    "docs-lookup": {
      "command": "npx",
      "args": [
        "-y",
        "@example/docs-mcp"
      ],
      "env": {
        "DOCS_API_KEY": "synthetic-docs-key",
        "DOCS_REGION": "example-region"
      }
    },
    "team-knowledge": {
      "type": "http",
      "url": "https://mcp.example.com/knowledge",
      "headers": {
        "Authorization": "Bearer synthetic-knowledge-token"
      }
    }
  }
}
