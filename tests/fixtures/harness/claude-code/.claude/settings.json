{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/check-command.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/format-check.sh"
          },
          {
            "type": "command",
            "command": "sh scripts/lint-check.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
