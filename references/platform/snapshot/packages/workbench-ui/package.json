{
  "name": "@infosec/workbench-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript/React renderer for the InfoSec harness and platform consoles, with an isolated browser preview adapter",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4190 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4190 --strictPort",
    "test:browser": "node test/browser.ts",
    "format:check": "prettier --check src test package.json tsconfig.json vite.config.ts index.html",
    "test:plugins": "node --test test/plugins.test.ts"
  },
  "dependencies": {
    "lucide-react": "1.55.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.14.3",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24"
  }
}
