{
  "schema": "skill@1",
  "parsers": [
    {
      "parser": "kityminder@1",
      "media_types": [
        "application/json"
      ],
      "limits": {
        "maxBytes": 16777216,
        "maxDepth": 200,
        "maxNodes": 100000
      },
      "function": {
        "module": "functions/parse.ts",
        "export": "default"
      },
      "locate": {
        "module": "functions/parse.ts",
        "export": "locate"
      }
    }
  ],
  "modules": [
    {
      "id": "case-structure",
      "title": "脑图用例读取",
      "family": "KityMinder 测试脑图：按树位置和声明字段读出用例、前置、动作和期望"
    }
  ]
}
