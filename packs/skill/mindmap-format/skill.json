{
  "schema": "skill@1",
  "parsers": [
    {
      "parser": "kityminder@1",
      "media_types": [
        "application/json"
      ],
      "limits": {
        "maxBytes": 16777216,
        "maxDepth": 200,
        "maxNodes": 100000
      },
      "function": {
        "module": "functions/parse.ts",
        "export": "default"
      },
      "locate": {
        "module": "functions/parse.ts",
        "export": "locate"
      },
      "migration_test": "mindmap-format migration equivalence across repository documents"
    }
  ]
}
