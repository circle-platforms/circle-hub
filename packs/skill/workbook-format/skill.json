{
  "schema": "skill@1",
  "parsers": [
    {
      "parser": "xlsx@1",
      "media_types": [
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "application/vnd.ms-excel.sheet.macroEnabled.12"
      ],
      "limits": {
        "maxBytes": 16777216,
        "maxDepth": 100,
        "maxNodes": 1000000,
        "maxAttributes": 1024
      },
      "function": {
        "module": "functions/parse.ts",
        "export": "default"
      },
      "locate": {
        "module": "functions/parse.ts",
        "export": "locate"
      },
      "migration_test": "workbook-format migration equivalence across repository documents"
    }
  ]
}
