{
  "schema": "system@1",
  "title": "敏捷测试平台",
  "description": "敏捷平台只读访问：配置根的子树、脑图及文档清单（关键词检索已退役：标题不打分、不选文档、不读正文，检索词只作披露）。所有配置根按读取预算读取，覆盖不足时明确披露；脑图和搜索共享聚合树，文档不在完整的配置范围内时直说。HTTP 200 信封 code=1000 成功；登录换令牌，明确过期仅登录一次，再失败即停。",
  "roles": [
    { "name": "agile-oauth", "description": "登录接口所在的地址（只用于登录，不读数据）" },
    { "name": "agile-api", "description": "平台接口所在的地址；请求头 Authorization 直接带令牌，不加前缀" }
  ],
  "auth": {
    "kind": "login_token",
    "header": { "name": "Authorization", "scheme": "raw" },
    "roles": ["agile-api"],
    "credentials": [
      { "name": "username", "digest": "plain", "description": "平台账号" },
      { "name": "password", "digest": "sha512_base64", "description": "密码，密钥库只保存 Base64(SHA-512(明文))" }
    ],
    "login": {
      "role": "agile-oauth",
      "method": "POST",
      "path": "/oauth/login/",
      "body": { "username": "{username}", "password": "{password}" },
      "token": "/data/token",
      "expiry": { "pointer": "/data/expire", "unit": "epoch_seconds" },
      "envelope": { "code": "/code", "ok": [1000], "message": "/msg" },
      "max_bytes": 65536,
      "timeout_ms": 30000
    }
  },
  "envelope": { "code": "/code", "ok": [1000], "expired": [401], "message": "/msg" },
  "routes": [
    {
      "id": "roots",
      "role": "agile-api",
      "method": "POST",
      "path": "/agile/get_root_node/",
      "body": { "type": "object", "properties": { "page": { "type": "integer", "minimum": 1, "maximum": 1000 } }, "required": ["page"], "additionalProperties": false },
      "response": "json",
      "envelope": true,
      "max_bytes": 1048576,
      "timeout_ms": 30000,
      "read": true,
      "description": "根列表的一页（每页 10 个，带 total；超出末页时重复第一页）"
    },
    {
      "id": "subtree",
      "role": "agile-api",
      "method": "POST",
      "path": "/agile/get_child_node_task/",
      "body": {
        "type": "object",
        "properties": { "id": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 999999999999999 }, { "type": "string", "maxLength": 64, "pattern": "^[0-9A-Za-z_-]{1,64}$" }] } },
        "required": ["id"],
        "additionalProperties": false
      },
      "response": "json",
      "envelope": true,
      "max_bytes": 67108864,
      "timeout_ms": 120000,
      "read": true,
      "description": "一个根的整棵子树 [{label, id, cases, children}]；叶子的编号是脑图文档编号"
    },
    {
      "id": "case-data",
      "role": "agile-api",
      "method": "POST",
      "path": "/agile/get_case_data/",
      "body": {
        "type": "object",
        "properties": { "id": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 999999999999999 }, { "type": "string", "maxLength": 64, "pattern": "^[0-9A-Za-z_-]{1,64}$" }] } },
        "required": ["id"],
        "additionalProperties": false
      },
      "response": "json",
      "envelope": true,
      "max_bytes": 33554432,
      "timeout_ms": 60000,
      "read": true,
      "description": "一份脑图文档：data 是再编码一次的 KityMinder JSON 字符串"
    }
  ],
  "reads": [
    {
      "name": "tree",
      "external": "agile:tree",
      "description": "一个根的整棵子树和根的标题；键 roots 读配置的每个根（每轮最多 4 个请求），列出全部文档",
      "plan": { "module": "functions/agile.ts", "export": "treePlan" },
      "project": { "module": "functions/agile.ts", "export": "treeProject" },
      "max_requests": 51
    },
    {
      "name": "mindmap",
      "external": "agile:mindmap",
      "description": "一份脑图文档，带标题和上级目录",
      "plan": { "module": "functions/agile.ts", "export": "mindmapPlan" },
      "project": { "module": "functions/agile.ts", "export": "mindmapProject" },
      "max_requests": 1
    },
    {
      "name": "case",
      "external": "agile:case",
      "description": "一份脑图文档本身，供用例索引批量读取：只发一次用例数据请求，不读目录树；content 是 KityMinder JSON，多一个包装成员 agile: {id} 写明文档编号",
      "plan": { "module": "functions/agile.ts", "export": "casePlan" },
      "project": { "module": "functions/agile.ts", "export": "caseProject" },
      "max_requests": 1
    },
    {
      "name": "search",
      "external": "agile:search",
      "description": "列出配置的根里的文档（编号、标题、上级目录、根），不含 ! 后精确编号排除的文档；关键词检索已退役（所有者裁定 U19/U20，2026-10-24）：标题不打分、不选文档、不读正文，检索词只作披露；只作线索",
      "plan": { "module": "functions/agile.ts", "export": "searchPlan" },
      "project": { "module": "functions/agile.ts", "export": "searchProject" },
      "max_requests": 4
    }
  ]
}
