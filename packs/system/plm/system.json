{
  "schema": "system@1",
  "title": "PLM 查询服务",
  "description": "PLM 查询服务的只读访问：缺陷详情（plm:bug:<编号>）、需求详情（plm:story:<编号>）、产品列表（plm:products:all）和一个产品的构建列表（plm:builds:<产品编号>）。读接口也用 POST，而且写接口与读接口同一个前缀，所以读路由逐条列出（方法加路径模板），写接口一条也没有列，传输层按路由清单拒绝它。登录与敏捷测试平台相同（同一个令牌可用）；信封 {code, msg, data}，code 1000 表示成功，构建列表的成功应答是不带信封的数组。",
  "roles": [
    {
      "name": "plm-oauth",
      "description": "登录接口所在的地址（只用于登录）"
    },
    {
      "name": "plm-api",
      "description": "查询服务的地址；请求头 Authorization 直接带令牌，不加前缀"
    }
  ],
  "auth": {
    "kind": "login_token",
    "header": {
      "name": "Authorization",
      "scheme": "raw"
    },
    "roles": [
      "plm-api"
    ],
    "credentials": [
      {
        "name": "username",
        "digest": "plain",
        "description": "账号"
      },
      {
        "name": "password",
        "digest": "sha512_base64",
        "description": "密码，密钥库只保存 Base64(SHA-512(明文))"
      }
    ],
    "login": {
      "role": "plm-oauth",
      "method": "POST",
      "path": "/oauth/login/",
      "body": {
        "username": "{username}",
        "password": "{password}"
      },
      "token": "/data/token",
      "expiry": {
        "pointer": "/data/expire",
        "unit": "epoch_seconds"
      },
      "envelope": {
        "code": "/code",
        "ok": [
          1000
        ],
        "message": "/msg"
      },
      "max_bytes": 65536,
      "timeout_ms": 30000
    }
  },
  "envelope": {
    "code": "/code",
    "ok": [
      1000
    ],
    "expired": [
      401
    ],
    "message": "/msg"
  },
  "routes": [
    {
      "id": "products",
      "role": "plm-api",
      "method": "GET",
      "path": "/plmquery/product/all/",
      "response": "json",
      "envelope": true,
      "max_bytes": 4194304,
      "timeout_ms": 30000,
      "read": true,
      "description": "全部产品"
    },
    {
      "id": "builds",
      "role": "plm-api",
      "method": "GET",
      "path": "/plmquery/build/",
      "query": {
        "type": "object",
        "properties": {
          "product": {
            "type": "string",
            "maxLength": 9,
            "pattern": "^[0-9]{1,9}$"
          }
        },
        "required": [
          "product"
        ],
        "additionalProperties": false
      },
      "response": "json",
      "envelope": "when_present",
      "max_bytes": 16777216,
      "timeout_ms": 60000,
      "read": true,
      "description": "一个产品的全部构建（一个数组，不分页）"
    },
    {
      "id": "bug-detail",
      "role": "plm-api",
      "method": "POST",
      "path": "/plmquery/bug/detail/",
      "body": {
        "type": "object",
        "properties": {
          "bug_ids": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999999999999999
                },
                {
                  "type": "string",
                  "maxLength": 15,
                  "pattern": "^[0-9]{1,15}$"
                }
              ]
            },
            "minItems": 1,
            "maxItems": 100
          }
        },
        "required": [
          "bug_ids"
        ],
        "additionalProperties": false
      },
      "response": "json",
      "envelope": true,
      "max_bytes": 16777216,
      "timeout_ms": 60000,
      "read": true,
      "description": "缺陷详情（读接口，用 POST）"
    },
    {
      "id": "story-detail",
      "role": "plm-api",
      "method": "POST",
      "path": "/plmquery/story/detail/",
      "body": {
        "type": "object",
        "properties": {
          "story_ids": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999999999999999
                },
                {
                  "type": "string",
                  "maxLength": 15,
                  "pattern": "^[0-9]{1,15}$"
                }
              ]
            },
            "minItems": 1,
            "maxItems": 100
          }
        },
        "required": [
          "story_ids"
        ],
        "additionalProperties": false
      },
      "response": "json",
      "envelope": true,
      "max_bytes": 16777216,
      "timeout_ms": 60000,
      "read": true,
      "description": "需求详情（读接口，用 POST）"
    }
  ],
  "reads": [
    {
      "name": "bug",
      "external": "plm:bug",
      "description": "一个缺陷：标题、状态、修复说明等字段（HTML 字段转成纯文本）",
      "plan": {
        "module": "functions/plm.ts",
        "export": "detailPlan"
      },
      "project": {
        "module": "functions/plm.ts",
        "export": "detailProject"
      },
      "max_requests": 1
    },
    {
      "name": "bugs",
      "external": "plm:bugs",
      "description": "多个缺陷的详情列表（编号用 + 连接，至多 50 个）：每个编号的 {id, status, title}，未读到的列为未知",
      "plan": {
        "module": "functions/plm.ts",
        "export": "bugsPlan"
      },
      "project": {
        "module": "functions/plm.ts",
        "export": "bugsProject"
      },
      "max_requests": 1
    },
    {
      "name": "story",
      "external": "plm:story",
      "description": "一个需求：标题、阶段、需求说明等字段（HTML 字段转成纯文本）",
      "plan": {
        "module": "functions/plm.ts",
        "export": "detailPlan"
      },
      "project": {
        "module": "functions/plm.ts",
        "export": "detailProject"
      },
      "max_requests": 1
    },
    {
      "name": "stories",
      "external": "plm:stories",
      "description": "多个需求的详情列表（编号用 + 连接，至多 50 个）：保留原样状态、阶段和标题，未返回的编号列为未知",
      "plan": {
        "module": "functions/plm.ts",
        "export": "storiesPlan"
      },
      "project": {
        "module": "functions/plm.ts",
        "export": "storiesProject"
      },
      "max_requests": 1
    },
    {
      "name": "products",
      "external": "plm:products",
      "description": "全部产品（编号写 all）",
      "request": {
        "route": "products"
      },
      "max_requests": 1
    },
    {
      "name": "builds",
      "external": "plm:builds",
      "description": "一个产品的构建列表（编号写产品编号）",
      "request": {
        "route": "builds",
        "query": {
          "product": "{id}"
        }
      },
      "max_requests": 1
    }
  ]
}
