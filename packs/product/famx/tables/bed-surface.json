{
  "schema": "bed-surface@1",
  "probes": [
    {
      "id": "addresses",
      "seat": "synthetic-0",
      "parser": "text_table",
      "header": "Interface       IP Address        Status",
      "fields": [
        {
          "name": "address",
          "start": 16,
          "end": 34,
          "cidr": true,
          "role": "residue",
          "from": "interfaces"
        }
      ],
      "empty": { "kind": "header_only" },
      "cleanups": [
        {
          "residue": "address",
          "command": "synthetic-clear-row",
          "granularity": "row",
          "confirm": "none",
          "channel": "single_shot"
        }
      ]
    },
    {
      "id": "sessions",
      "seat": "synthetic-0",
      "parser": "text_table",
      "header": "Session-ID      Source                  Destination",
      "fields": [
        {
          "name": "name",
          "start": 0,
          "end": 16,
          "role": "residue",
          "from": "values",
          "values": []
        }
      ],
      "empty": { "kind": "header_only" },
      "cleanups": [
        {
          "residue": "name",
          "command": "synthetic-confirm-clear",
          "granularity": "table",
          "confirm": "interactive",
          "channel": "single_shot",
          "exit": {
            "action": "在座位上确认后执行声明的清理命令",
            "object": "探针 sessions",
            "owner": "合成管理员",
            "deadline": "重新派发之前"
          }
        }
      ]
    }
  ]
}
