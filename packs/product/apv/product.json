{
  "schema": "product@1",
  "id": "apv",
  "title": "APV / NSAE",
  "names": [
    "APV",
    "NSAE"
  ],
  "sync": {
    "start": [
      "buildsite:listing:index"
    ],
    "plan": {
      "module": "functions/sync.ts"
    },
    "options": {
      "include": [],
      "exclude": [],
      "case_index": true,
      "min_line": "${var:APV_MIN_LINE}",
      "mainline_page_words": "${var:APV_MAINLINE_PAGE_WORDS}",
      "adoc": {
        "APV": {
          "root": "${var:APV_ADOC_ROOT}",
          "main": "${var:APV_ADOC_MAIN}"
        },
        "NSAE": {
          "root": "${var:NSAE_ADOC_ROOT}",
          "main": "${var:NSAE_ADOC_MAIN}"
        }
      },
      "spec_index": true
    },
    "max_rounds": 10,
    "max_reads": 300
  },
  "select_build": {
    "module": "functions/select.ts"
  },
  "links": [
    {
      "id": "manual-literals",
      "field": "command_literals",
      "namespace": "/commands",
      "match": "longest_prefix",
      "entry_kind": "definition",
      "normalize": {
        "lowercase": true,
        "strip_nul": true,
        "nfc": true
      },
      "source_producers": [
        "manual-apv",
        "manual-nsae"
      ],
      "target_producers": [
        "command-tree"
      ]
    },
    {
      "id": "manual-signatures",
      "alternatives_field": "signature_literals",
      "namespace": "/commands",
      "match": "exact",
      "entry_kind": "definition",
      "normalize": {
        "lowercase": true,
        "strip_nul": true,
        "nfc": true
      },
      "source_producers": [
        "manual-apv",
        "manual-nsae"
      ],
      "target_producers": [
        "command-tree"
      ]
    }
  ],
  "catalogs": [
    {
      "id": "commands@1",
      "entry_kind": "definition",
      "producer": "command-tree",
      "complete": true,
      "case_sensitive": false
    }
  ],
  "producers": [
    {
      "id": "command-tree",
      "title": "命令树（构建自带的 command_tree XML）",
      "function": {
        "module": "functions/producers.ts",
        "export": "commandTree"
      },
      "inputs": {
        "tree": {
          "source": "tree"
        }
      }
    },
    {
      "id": "manual-nsae",
      "title": "NSAE 手册（独立属性与产出范围）",
      "function": {
        "module": "functions/adoc/deployment.ts",
        "export": "familyManual"
      },
      "inputs": {
        "cli": {
          "external": "manual:cli:{line}",
          "optional": true
        },
        "app": {
          "external": "manual:app:{line}",
          "optional": true
        },
        "tree": {
          "source": "tree"
        },
        "meta": {
          "source": "adoc_nsae_meta",
          "optional": true
        },
        "files": {
          "source": "adoc_nsae_files",
          "many": true,
          "batch": 200,
          "optional": true
        }
      },
      "params": {
        "family": "NSAE",
        "root": "${var:NSAE_ADOC_ROOT}",
        "main": "${var:NSAE_ADOC_MAIN}",
        "attributes": {
          "NSAE": "${var:APV_ADOC_ATTRIBUTES_NSAE}"
        },
        "components": "${var:APV_COMPONENTS}",
        "licenses": "${var:APV_LICENSES}",
        "deployment_forms": "${var:APV_DEPLOYMENT_FORMS}"
      },
      "placement": "judgment_allowed"
    },
    {
      "id": "manual-apv",
      "title": "APV 手册（独立属性与产出范围）",
      "function": {
        "module": "functions/adoc/deployment.ts",
        "export": "familyManual"
      },
      "inputs": {
        "cli": {
          "external": "manual:cli:{line}",
          "optional": true
        },
        "app": {
          "external": "manual:app:{line}",
          "optional": true
        },
        "tree": {
          "source": "tree"
        },
        "meta": {
          "source": "adoc_apv_meta",
          "optional": true
        },
        "files": {
          "source": "adoc_apv_files",
          "many": true,
          "batch": 200,
          "optional": true
        }
      },
      "params": {
        "family": "APV",
        "root": "${var:APV_ADOC_ROOT}",
        "main": "${var:APV_ADOC_MAIN}",
        "attributes": {
          "APV": "${var:APV_ADOC_ATTRIBUTES_APV}"
        },
        "components": "${var:APV_COMPONENTS}",
        "licenses": "${var:APV_LICENSES}",
        "deployment_forms": "${var:APV_DEPLOYMENT_FORMS}"
      },
      "placement": "judgment_allowed"
    },
    {
      "id": "release-notes",
      "title": "修复的缺陷（构建的修复缺陷清单）",
      "function": {
        "module": "functions/producers.ts",
        "export": "releaseNotes"
      },
      "inputs": {
        "notes": {
          "source": "fixed_bugs",
          "optional": true
        }
      }
    },
    {
      "id": "cases",
      "title": "用例（敏捷平台的测试脑图，按用例涉及的命令归档）",
      "function": {
        "module": "functions/cases.ts",
        "export": "cases"
      },
      "inputs": {
        "documents": {
          "source": "case_documents",
          "many": true,
          "batch": 40,
          "optional": true
        },
        "tree": {
          "source": "tree"
        },
        "folders": {
          "source": "case_tree",
          "optional": true
        }
      }
    },
    {
      "id": "specifications",
      "title": "产品线不分版本的规格章节",
      "unversioned": true,
      "function": {
        "module": "functions/specifications.ts",
        "export": "specifications"
      },
      "inputs": {
        "documents": {
          "source": "spec_documents",
          "many": true,
          "batch": 20,
          "optional": true
        },
        "catalog": {
          "source": "spec_catalog",
          "optional": true
        }
      },
      "params": {
        "components": "${var:APV_COMPONENTS}",
        "licenses": "${var:APV_LICENSES}",
        "deployment_forms": "${var:APV_DEPLOYMENT_FORMS}"
      }
    }
  ],
  "variables": [
    {
      "name": "APV_MIN_LINE",
      "description": "Minimum release-train line for case indexing; null imposes no floor",
      "schema": {
        "type": [
          "string",
          "null"
        ]
      },
      "default": null
    },
    {
      "name": "APV_MAINLINE_PAGE_WORDS",
      "description": "Additional literal tokens permitted after a mainline page version",
      "schema": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "default": []
    },
    {
      "name": "APV_ADOC_ROOT",
      "description": "SVN directory template with {line}; explicit null selects Markdown",
      "schema": {
        "type": [
          "string",
          "null"
        ]
      },
      "default": null
    },
    {
      "name": "APV_ADOC_MAIN",
      "description": "Main adoc file relative to the configured family directory",
      "schema": {
        "type": "string",
        "minLength": 1
      },
      "default": "book.adoc"
    },
    {
      "name": "APV_ADOC_ATTRIBUTES_APV",
      "description": "Explicit attribute set for this family; empty is an explicit set",
      "schema": {
        "type": "object",
        "additionalProperties": {
          "type": [
            "string",
            "boolean"
          ]
        }
      },
      "default": {}
    },
    {
      "name": "NSAE_ADOC_ROOT",
      "description": "SVN directory template with {line}; explicit null selects Markdown",
      "schema": {
        "type": [
          "string",
          "null"
        ]
      },
      "default": null
    },
    {
      "name": "NSAE_ADOC_MAIN",
      "description": "Main adoc file relative to the configured family directory",
      "schema": {
        "type": "string",
        "minLength": 1
      },
      "default": "book.adoc"
    },
    {
      "name": "APV_ADOC_ATTRIBUTES_NSAE",
      "description": "Explicit attribute set for this family; empty is an explicit set",
      "schema": {
        "type": "object",
        "additionalProperties": {
          "type": [
            "string",
            "boolean"
          ]
        }
      },
      "default": {}
    },
    {
      "name": "APV_COMPONENTS",
      "description": "APV_COMPONENTS：适用条件的部署闭集；只填手册中明写的名称，空集须显式设置 []",
      "schema": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "default": []
    },
    {
      "name": "APV_LICENSES",
      "description": "APV_LICENSES：适用条件的部署闭集；只填手册中明写的名称，空集须显式设置 []",
      "schema": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "default": []
    },
    {
      "name": "APV_DEPLOYMENT_FORMS",
      "description": "APV_DEPLOYMENT_FORMS：适用条件的部署闭集；只填手册中明写的名称，空集须显式设置 []",
      "schema": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "default": []
    }
  ]
}
