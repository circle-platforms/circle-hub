{
  "schema": "product@1",
  "id": "apv",
  "title": "APV / NSAE",
  "names": [
    "APV",
    "NSAE"
  ],
  "sync": {
    "start": [
      "buildsite:listing:index"
    ],
    "plan": {
      "module": "functions/sync.ts"
    },
    "options": {
      "include": "${var:APV_INCLUDE_PAGES}",
      "pinned": "${var:APV_PINNED_BUILDS}",
      "exclude": [],
      "case_index": false,
      "min_line": "${var:APV_MIN_LINE}",
      "mainline_page_words": "${var:APV_MAINLINE_PAGE_WORDS}",
      "adoc": {
        "APV": {
          "root": "${var:APV_ADOC_ROOT}",
          "main": "${var:APV_ADOC_MAIN}",
          "app_main": "${var:APV_ADOC_APP_MAIN}"
        },
        "NSAE": {
          "root": "${var:NSAE_ADOC_ROOT}",
          "main": "${var:NSAE_ADOC_MAIN}",
          "app_main": "${var:NSAE_ADOC_APP_MAIN}"
        }
      },
      "spec_index": false
    },
    "max_rounds": 10,
    "max_reads": 300
  },
  "select_build": {
    "module": "functions/select.ts"
  },
  "links": [
    {
      "id": "manual-literals",
      "field": "command_literals",
      "namespace": "/commands",
      "match": "exact",
      "entry_kind": "definition",
      "normalize": {
        "lowercase": false,
        "strip_nul": false,
        "nfc": false
      },
      "source_producers": [
        "manual-apv",
        "manual-nsae"
      ],
      "target_producers": [
        "command-tree"
      ]
    },
    {
      "id": "manual-signatures",
      "alternatives_field": "signature_literals",
      "namespace": "/commands",
      "match": "exact",
      "entry_kind": "definition",
      "normalize": {
        "lowercase": false,
        "strip_nul": false,
        "nfc": false
      },
      "source_producers": [
        "manual-apv",
        "manual-nsae"
      ],
      "target_producers": [
        "command-tree"
      ]
    }
  ],
  "catalogs": [
    {
      "id": "commands@1",
      "entry_kind": "definition",
      "producer": "command-tree",
      "complete": true,
      "case_sensitive": true
    }
  ],
  "producers": [
    {
      "id": "command-tree",
      "title": "命令树（构建自带的 command_tree XML）",
      "function": {
        "module": "functions/producers.ts",
        "export": "commandTree"
      },
      "inputs": {
        "tree": {
          "source": "tree"
        }
      }
    },
    {
      "id": "manual-nsae",
      "title": "NSAE 手册（独立属性与产出范围）",
      "function": {
        "module": "functions/adoc/deployment.ts",
        "export": "familyManual"
      },
      "inputs": {
        "cli": {
          "external": "manual:cli:{line}",
          "optional": true
        },
        "app": {
          "external": "manual:app:{line}",
          "optional": true
        },
        "tree": {
          "source": "tree"
        },
        "meta": {
          "source": "adoc_nsae_meta",
          "optional": true
        },
        "files": {
          "source": "adoc_nsae_files",
          "many": true,
          "batch": 200,
          "optional": true
        }
      },
      "params": {
        "family": "NSAE",
        "root": "${var:NSAE_ADOC_ROOT}",
        "main": "${var:NSAE_ADOC_MAIN}",
        "attributes": {
          "NSAE": "${var:APV_ADOC_ATTRIBUTES_NSAE}"
        },
        "models": "${var:APV_MODELS}",
        "platforms": "${var:APV_PLATFORMS}",
        "components": "${var:APV_COMPONENTS}",
        "licenses": "${var:APV_LICENSES}",
        "deployment_forms": "${var:APV_DEPLOYMENT_FORMS}",
        "app_main": "${var:NSAE_ADOC_APP_MAIN}",
        "signature_structure": {
          "schema": "apv-adoc-signature-structure@1",
          "block": "paragraph",
          "inline": [
            "strong",
            "optional whitespace + emphasis"
          ],
          "command_word_grammar": "locked-tree-path-and-ascii-drift-slot@1",
          "variants": "bounded {a|b} groups",
          "parameter_authority": "locked command-tree declarations",
          "other_blocks": "chapter content"
        }
      },
      "placement": "judgment_allowed"
    },
    {
      "id": "manual-apv",
      "title": "APV 手册（独立属性与产出范围）",
      "function": {
        "module": "functions/adoc/deployment.ts",
        "export": "familyManual"
      },
      "inputs": {
        "cli": {
          "external": "manual:cli:{line}",
          "optional": true
        },
        "app": {
          "external": "manual:app:{line}",
          "optional": true
        },
        "tree": {
          "source": "tree"
        },
        "meta": {
          "source": "adoc_apv_meta",
          "optional": true
        },
        "files": {
          "source": "adoc_apv_files",
          "many": true,
          "batch": 200,
          "optional": true
        }
      },
      "params": {
        "family": "APV",
        "root": "${var:APV_ADOC_ROOT}",
        "main": "${var:APV_ADOC_MAIN}",
        "attributes": {
          "APV": "${var:APV_ADOC_ATTRIBUTES_APV}"
        },
        "models": "${var:APV_MODELS}",
        "platforms": "${var:APV_PLATFORMS}",
        "components": "${var:APV_COMPONENTS}",
        "licenses": "${var:APV_LICENSES}",
        "deployment_forms": "${var:APV_DEPLOYMENT_FORMS}",
        "app_main": "${var:APV_ADOC_APP_MAIN}",
        "signature_structure": {
          "schema": "apv-adoc-signature-structure@1",
          "block": "paragraph",
          "inline": [
            "strong",
            "optional whitespace + emphasis"
          ],
          "command_word_grammar": "locked-tree-path-and-ascii-drift-slot@1",
          "variants": "bounded {a|b} groups",
          "parameter_authority": "locked command-tree declarations",
          "other_blocks": "chapter content"
        }
      },
      "placement": "judgment_allowed"
    },
    {
      "id": "release-notes",
      "title": "修复的缺陷（构建的修复缺陷清单）",
      "function": {
        "module": "functions/producers.ts",
        "export": "releaseNotes"
      },
      "inputs": {
        "notes": {
          "source": "fixed_bugs",
          "optional": true
        }
      }
    },
    {
      "id": "specifications",
      "title": "产品线不分版本的规格章节",
      "unversioned": true,
      "function": {
        "module": "functions/specifications.ts",
        "export": "specifications"
      },
      "inputs": {
        "documents": {
          "source": "spec_documents",
          "many": true,
          "batch": 20,
          "optional": true
        },
        "catalog": {
          "source": "spec_catalog",
          "optional": true
        }
      },
      "params": {
        "components": "${var:APV_COMPONENTS}",
        "licenses": "${var:APV_LICENSES}",
        "deployment_forms": "${var:APV_DEPLOYMENT_FORMS}"
      }
    }
  ],
  "variables": [
    {
      "name": "APV_MIN_LINE",
      "description": "Minimum release-train line for case indexing; null imposes no floor",
      "schema": {
        "type": [
          "string",
          "null"
        ]
      },
      "default": null
    },
    {
      "name": "APV_PINNED_BUILDS",
      "description": "Full build names in the build-site spelling; on a read opted-in page, an entry whose build name equals a member exactly (no transformation, not even case folding) is listed as a build of its own tree, released or not",
      "schema": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "default": []
    },
    {
      "name": "APV_INCLUDE_PAGES",
      "description": "Glob patterns over listing page names that opt platform, customer and patch pages into the sync; empty selects only the mainline pages",
      "schema": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "default": []
    },
    {
      "name": "APV_MAINLINE_PAGE_WORDS",
      "description": "Additional literal tokens permitted after a mainline page version",
      "schema": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "default": []
    },
    {
      "name": "APV_ADOC_ROOT",
      "description": "SVN directory template with original {line} or naming-derived {line_dir}; explicit null selects Markdown",
      "schema": {
        "type": [
          "string",
          "null"
        ]
      },
      "default": null
    },
    {
      "name": "APV_ADOC_MAIN",
      "description": "CLI main adoc file relative to the configured family directory",
      "schema": {
        "type": "string",
        "minLength": 1
      },
      "default": "book.adoc"
    },
    {
      "name": "APV_ADOC_ATTRIBUTES_APV",
      "description": "Explicit attribute set for this family; empty is an explicit set",
      "schema": {
        "type": "object",
        "additionalProperties": {
          "type": [
            "string",
            "boolean"
          ]
        }
      },
      "default": {}
    },
    {
      "name": "NSAE_ADOC_ROOT",
      "description": "SVN directory template with original {line} or naming-derived {line_dir}; explicit null selects Markdown",
      "schema": {
        "type": [
          "string",
          "null"
        ]
      },
      "default": null
    },
    {
      "name": "NSAE_ADOC_MAIN",
      "description": "CLI main adoc file relative to the configured family directory",
      "schema": {
        "type": "string",
        "minLength": 1
      },
      "default": "book.adoc"
    },
    {
      "name": "APV_ADOC_ATTRIBUTES_NSAE",
      "description": "Explicit attribute set for this family; empty is an explicit set",
      "schema": {
        "type": "object",
        "additionalProperties": {
          "type": [
            "string",
            "boolean"
          ]
        }
      },
      "default": {}
    },
    {
      "name": "APV_COMPONENTS",
      "description": "APV_COMPONENTS：适用条件的部署闭集；只填手册中明写的名称，空集须显式设置 []",
      "schema": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "default": []
    },
    {
      "name": "APV_LICENSES",
      "description": "APV_LICENSES：适用条件的部署闭集；只填手册中明写的名称，空集须显式设置 []",
      "schema": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "default": []
    },
    {
      "name": "APV_DEPLOYMENT_FORMS",
      "description": "APV_DEPLOYMENT_FORMS：适用条件的部署闭集；只填手册中明写的名称，空集须显式设置 []",
      "schema": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "default": []
    },
    {
      "name": "APV_MODELS",
      "description": "Exact model identities permitted in structured applicability declarations; no synonym mapping",
      "schema": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "default": []
    },
    {
      "name": "APV_PLATFORMS",
      "description": "Exact platform identities permitted in structured applicability declarations; no synonym mapping",
      "schema": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "default": []
    },
    {
      "name": "APV_ADOC_APP_MAIN",
      "description": "APP main adoc file relative to the family directory, compiled with the same family attributes as CLI",
      "schema": {
        "type": "string",
        "minLength": 1
      },
      "default": "app.adoc"
    },
    {
      "name": "NSAE_ADOC_APP_MAIN",
      "description": "APP main adoc file relative to the family directory, compiled with the same family attributes as CLI",
      "schema": {
        "type": "string",
        "minLength": 1
      },
      "default": "app.adoc"
    }
  ],
  "applicability": {
    "closed_sets": {
      "models": "APV_MODELS",
      "platforms": "APV_PLATFORMS",
      "components": "APV_COMPONENTS",
      "licenses": "APV_LICENSES",
      "deployment_forms": "APV_DEPLOYMENT_FORMS"
    },
    "build_validator": {
      "module": "functions/naming.ts",
      "export": "validateBuildNames"
    },
    "grammar": "apv-applicability@1"
  },
  "feeding": {
    "project": {
      "module": "functions/feeding.ts"
    },
    "normalize_line": {
      "module": "functions/feeding.ts",
      "export": "normalizeLine"
    },
    "verify_command": {
      "module": "functions/feeding.ts",
      "export": "verifyCommand"
    },
    "classifications": {
      "module": "functions/feeding.ts",
      "export": "classificationValues"
    }
  }
}
