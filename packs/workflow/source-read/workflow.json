{
  "schema": "workflow@1",
  "inputs": [
    {
      "slot": "defect",
      "role": "subject",
      "description": "缺陷详情：PLM 查询服务的缺陷记录（plm:bug:<编号>）",
      "accepts": [
        "plm:bug"
      ],
      "required": false,
      "many": false
    },
    {
      "slot": "defect_list",
      "role": "subject",
      "description": "按条件列出的缺陷：PLM 查询服务的缺陷列表（plm:bug-list:<条件>，条件写成 名=值，多个用 & 连接，值做 URI 编码；名取 product、status、severity、assignedTo、openedBy、lastEditedDate_start、lastEditedDate_end，每个最多一次，至少一个；例如经办人是 alice 的激活缺陷写 plm:bug-list:assignedTo=alice&status=active）。列表接口不分页，回答带过滤条件和行数；空列表只说明读取时刻按这些条件没有匹配",
      "accepts": [
        "plm:bug-list"
      ],
      "required": false,
      "many": false
    },
    {
      "slot": "story",
      "role": "subject",
      "description": "需求详情：PLM 查询服务的需求记录（plm:story:<编号>）",
      "accepts": [
        "plm:story"
      ],
      "required": false,
      "many": false
    },
    {
      "slot": "build",
      "role": "subject",
      "description": "构建列表：PLM 查询服务的一个产品的构建列表（plm:builds:<产品编号> 或 plm:builds:<产品名>）",
      "accepts": [
        "plm:builds"
      ],
      "required": false,
      "many": false
    },
    {
      "slot": "mindmap",
      "role": "subject",
      "description": "脑图文档：敏捷测试平台的脑图文档（agile:mindmap:<文档编号>）",
      "accepts": [
        "agile:mindmap"
      ],
      "required": false,
      "many": false
    },
    {
      "slot": "build_page",
      "role": "subject",
      "description": "构建页：构建站的页面（buildsite:listing:<页面名>）或命令树文件（buildsite:file:<链接>）",
      "accepts": [
        "buildsite:listing",
        "buildsite:file"
      ],
      "required": false,
      "many": false
    },
    {
      "slot": "manual_file",
      "role": "subject",
      "description": "手册文件：手册库或文档库按路径读取的一个文件（manual:file:<路径> 或 openkm:file:<路径>）",
      "accepts": [
        "manual:file",
        "openkm:file"
      ],
      "required": false,
      "many": false
    },
    {
      "slot": "svn_file",
      "role": "subject",
      "description": "SVN 文件：SVN 只读仓库按修订号和路径读取的文件（svn:file:<修订号>/<路径>）",
      "accepts": [
        "svn:file"
      ],
      "required": false,
      "many": false
    }
  ],
  "parameters": [],
  "product": {
    "catalogs": []
  },
  "subject": "defect",
  "projection": {
    "module": "functions/project.ts"
  }
}
