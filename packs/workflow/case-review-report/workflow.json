{
  "schema": "workflow@1",
  "inputs": [
    {
      "slot": "verifications",
      "role": "expected",
      "description": "各块复核运行的验证结果：每块一次复核 submit_result 回执里的 rec:<摘要>（Hub 记录，不带 # 指针）；每块一条，至少一条",
      "accepts": [
        "application/json"
      ],
      "required": true,
      "many": true
    },
    {
      "slot": "target",
      "role": "subject",
      "description": "各块评审的同一份测试脑图，按条目位置核对源摘要并逐字排出评审表",
      "accepts": [
        "agile:mindmap",
        "application/json"
      ],
      "required": true,
      "many": false
    }
  ],
  "parameters": [
    {
      "name": "precondition_priority",
      "description": "用例里前置条件叶子的优先级标记，默认 3；null 关闭这条规则",
      "required": false,
      "schema": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          {
            "type": "null"
          }
        ]
      }
    }
  ],
  "product": {
    "catalogs": []
  },
  "subject": "target",
  "projection": {
    "module": "functions/projection.ts"
  }
}
