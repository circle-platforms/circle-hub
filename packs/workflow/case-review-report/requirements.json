{
  "schema": "requirements@1",
  "requirements": [
    {
      "key": "overall",
      "name": "整体结论与等级",
      "description": "Hub 按各块复核结果算的整体结论，一个跨条目事实：各块取最差（FAIL 重于 PARTIAL 重于 PASS），等级取最差那块的等级；任何一块没有结论或不可读时整体记未知（缺输入），不猜；整份目标里有条目在任何一块都没交付时整体记未完成并在陈述里写出缺哪些条目。依据是各块结论的 rec: 引用",
      "target": "run",
      "required": true,
      "done_rule": "bookkeeping",
      "layers": [
        "static"
      ],
      "accepted_producer": "fact",
      "checks": [
        "overall"
      ],
      "error_handling": [
        {
          "code": "case-review-report.blocks_differ",
          "action": "reject"
        },
        {
          "code": "case-review-report.missing_blocks",
          "action": "reject"
        }
      ]
    },
    {
      "key": "report",
      "name": "中文报告",
      "description": "评审终稿，跨条目判断：一条 code=report 的主张（陈述写中文报告全文并写明整体结论，rank 写等级——都等于 Hub 算出的值），每条证实、部分正确和新增的发现以 grounds 里的 rec: 引用引到（一条不漏，推翻的不能引）；每条建议一条 code=suggestion 的主张，陈述按“补：<用例>；因为：<原因>；期望：<结果>”三段写；证据缺口各一条 code=gap 的主张。报告只总结复核方的材料，不重新评审",
      "target": "run",
      "required": true,
      "done_rule": "bookkeeping",
      "layers": [
        "static"
      ],
      "accepted_producer": "judgment",
      "checks": [
        "report"
      ],
      "error_handling": [
        {
          "code": "case-review-report.verdict_mismatch",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-review-report.finding_missing",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-review-report.finding_refuted",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-review-report.suggestion_incomplete",
          "action": "repair",
          "max_rounds": 2
        }
      ]
    }
  ]
}
