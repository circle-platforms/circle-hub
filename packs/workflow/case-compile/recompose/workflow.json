{
  "schema": "workflow@1",
  "inputs": [
    {
      "slot": "subject",
      "role": "subject",
      "required": true,
      "many": false,
      "accepts": [
        "application/json",
        "agile:mindmap"
      ],
      "description": "subject exact bound source"
    },
    {
      "slot": "authority_run",
      "role": "expected",
      "required": false,
      "many": false,
      "accepts": [
        "application/json"
      ],
      "description": "authority_run exact bound source"
    },
    {
      "slot": "authority_result",
      "role": "expected",
      "required": false,
      "many": false,
      "accepts": [
        "application/json"
      ],
      "description": "authority_result exact bound source"
    },
    {
      "slot": "review_run",
      "role": "expected",
      "required": false,
      "many": false,
      "accepts": [
        "application/json"
      ],
      "description": "review_run exact bound source"
    },
    {
      "slot": "review_result",
      "role": "expected",
      "required": false,
      "many": false,
      "accepts": [
        "application/json"
      ],
      "description": "review_result exact bound source"
    },
    {
      "slot": "previous_run",
      "role": "expected",
      "required": false,
      "many": false,
      "accepts": [
        "application/json"
      ],
      "description": "previous_run exact bound source"
    },
    {
      "slot": "previous_result",
      "role": "expected",
      "required": false,
      "many": false,
      "accepts": [
        "application/json"
      ],
      "description": "previous_result exact bound source"
    },
    {
      "slot": "evidence",
      "role": "expected",
      "required": false,
      "many": true,
      "accepts": [
        "application/json",
        "doc:doc",
        "agile:mindmap"
      ],
      "description": "evidence exact bound source"
    }
  ],
  "parameters": [
    {
      "name": "case_depths",
      "description": "Declared absolute depths, no text heuristics",
      "required": false,
      "schema": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      }
    },
    {
      "name": "scope",
      "description": "按范围重组时传入，开运行时冻结进运行记录：{\"words\":\"<范围原话>\",\"cases\":[\"<autoid>\",...]}。只为范围内的原始用例投影条目与封批，完整脑图仍下载作上下文；中途改范围须用 start_run 重开重组运行",
      "required": false,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["words", "cases"],
        "properties": {
          "words": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "cases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        }
      }
    }
  ],
  "product": {
    "catalogs": [
      "commands@1"
    ]
  },
  "subject": "subject",
  "projection": {
    "module": "functions/project.ts"
  },
  "incremental_submissions": true
}
