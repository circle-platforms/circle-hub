{
  "schema": "slots@1",
  "item": {
    "plan": {
      "min": 1,
      "max": 1,
      "data": {
        "type": "object",
        "required": [
          "bucket",
          "blocks",
          "steps",
          "expects",
          "replacements"
        ],
        "additionalProperties": false,
        "properties": {
          "bucket": {
            "type": "string",
            "minLength": 1
          },
          "blocks": {
            "type": "array",
            "maxItems": 0
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "object",
                "method",
                "args",
                "keywords"
              ],
              "additionalProperties": false,
              "properties": {
                "object": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "keywords": {
                  "type": "object",
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    ]
                  }
                },
                "cleanup": {
                  "type": "boolean",
                  "description": "true 将步骤标为末尾清理段；按产品声明逆序执行对应逆操作，不能从文字猜测"
                }
              }
            }
          },
          "expects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "text",
                "quote",
                "after"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "object",
                  "required": [
                    "reference",
                    "text"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "reference": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "after": {
                  "type": "integer",
                  "minimum": 1
                },
                "basis": {
                  "type": "string",
                  "description": "显式声明 model_judgment 时 text 是模型选择的设备可观察检查文字；不写时维持引文片段规则",
                  "enum": [
                    "model_judgment"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "description": "model_judgment 的非空理由；声明是模型判断，Hub 不断言其语义正确"
                }
              }
            }
          },
          "replacements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "case",
                "bed"
              ],
              "additionalProperties": false,
              "properties": {
                "case": {
                  "type": "string",
                  "minLength": 1
                },
                "bed": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "command_identities": {
            "type": "array",
            "description": "可选的模型身份声明；通常省略。Hub 从 steps 的完整设备命令行按锁定树解析 CommandIdentity，不要求模型填写类型值。若主动声明，commands_known 逐项核结构并与 Hub 解析身份集合完全比对，不一致记违规；不得用声明代替解析",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "run": {}
}
