{
  "schema": "case-compile.blocks-format@1",
  "kinds": [
    {
      "kind": "CONFIG",
      "enabled": true,
      "required": [
        "id",
        "kind",
        "call"
      ],
      "fields": [
        "id",
        "kind",
        "call",
        "cleanup",
        "input_register",
        "author_step_refs",
        "description"
      ]
    },
    {
      "kind": "OBSERVE_ASSERT",
      "enabled": true,
      "required": [
        "id",
        "kind",
        "call",
        "assertions"
      ],
      "fields": [
        "id",
        "kind",
        "call",
        "assertions",
        "author_step_refs",
        "description"
      ]
    },
    {
      "kind": "OBSERVE_ONLY",
      "enabled": true,
      "required": [
        "id",
        "kind",
        "call"
      ],
      "fields": [
        "id",
        "kind",
        "call",
        "author_step_refs",
        "description"
      ]
    },
    {
      "kind": "CAPTURE",
      "enabled": true,
      "required": [
        "id",
        "kind",
        "call",
        "register"
      ],
      "fields": [
        "id",
        "kind",
        "call",
        "register",
        "author_step_refs",
        "description"
      ]
    },
    {
      "kind": "SELECT_CELL",
      "enabled": true,
      "required": [
        "id",
        "kind",
        "call",
        "from",
        "register",
        "table",
        "column",
        "select"
      ],
      "fields": [
        "id",
        "kind",
        "call",
        "from",
        "register",
        "table",
        "column",
        "select",
        "author_step_refs",
        "description"
      ]
    },
    {
      "kind": "CAPTURE_COMPARE",
      "enabled": true,
      "required": [
        "id",
        "kind",
        "left",
        "right",
        "relation",
        "output",
        "quote",
        "expectation"
      ],
      "fields": [
        "id",
        "kind",
        "left",
        "right",
        "relation",
        "output",
        "quote",
        "expectation",
        "criterion",
        "author_step_refs",
        "description"
      ]
    },
    {
      "kind": "EXPECT_FROM",
      "enabled": true,
      "required": [
        "id",
        "kind",
        "call",
        "expected_from",
        "op",
        "output",
        "quote",
        "expectation"
      ],
      "fields": [
        "id",
        "kind",
        "call",
        "expected_from",
        "op",
        "output",
        "quote",
        "expectation",
        "criterion",
        "author_step_refs",
        "description"
      ]
    },
    {
      "kind": "SLEEP",
      "enabled": true,
      "required": [
        "id",
        "kind",
        "call"
      ],
      "fields": [
        "id",
        "kind",
        "call",
        "author_step_refs",
        "description"
      ]
    },
    {
      "kind": "STEP",
      "enabled": true,
      "required": [
        "id",
        "kind",
        "call"
      ],
      "fields": [
        "id",
        "kind",
        "call",
        "output",
        "register",
        "cleanup",
        "input_register",
        "author_step_refs",
        "description"
      ]
    },
    {
      "kind": "RESTORE_FROM",
      "enabled": true,
      "required": [
        "id",
        "kind",
        "call",
        "register",
        "for"
      ],
      "fields": [
        "id",
        "kind",
        "call",
        "register",
        "for",
        "author_step_refs",
        "description"
      ]
    },
    {
      "kind": "OBSERVE_DIST",
      "enabled": false,
      "required": [
        "id",
        "kind",
        "payload"
      ],
      "fields": [
        "id",
        "kind",
        "payload",
        "description"
      ],
      "missing": "缺已发布的分布区间、守恒派生规则及运行器能力",
      "next_action": "工作包与执行器维护者补结构声明、来源及合成正反例，升版发布后重开运行；不从回显猜结论"
    },
    {
      "kind": "OBSERVE_MEMBER",
      "enabled": false,
      "required": [
        "id",
        "kind",
        "payload"
      ],
      "fields": [
        "id",
        "kind",
        "payload",
        "description"
      ],
      "missing": "缺已发布的成员关系派生规则及运行器能力",
      "next_action": "工作包与执行器维护者补结构声明、来源及合成正反例，升版发布后重开运行；不从回显猜结论"
    },
    {
      "kind": "OBSERVE_EXIT",
      "enabled": false,
      "required": [
        "id",
        "kind",
        "payload"
      ],
      "fields": [
        "id",
        "kind",
        "payload",
        "description"
      ],
      "missing": "缺受认证的退出状态观察通道",
      "next_action": "工作包与执行器维护者补结构声明、来源及合成正反例，升版发布后重开运行；不从回显猜结论"
    }
  ],
  "fields": {
    "call": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keywords": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            ]
          }
        }
      },
      "required": [
        "object",
        "method",
        "args",
        "keywords"
      ]
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "output": {
            "type": "string",
            "minLength": 1
          },
          "op": {
            "type": "string",
            "minLength": 1
          },
          "literal": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reference",
              "text"
            ]
          },
          "expectation": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1,
            "description": "Id of the typed criterion in criteria[] that holds your own checkpoint for this author expectation. Write it only when the expectation node carries no literal declaration. The checkpoint is a model judgment, status 未确认, decided by the device run; no independent review is needed and none is started. The criterion's quote, operator and literal (or count, or relation) must equal this assertion's."
          }
        },
        "required": [
          "id",
          "output",
          "op",
          "literal",
          "quote",
          "expectation"
        ]
      },
      "minItems": 1,
      "maxItems": 64
    },
    "register": {
      "type": "string",
      "minLength": 1
    },
    "left": {
      "type": "string",
      "minLength": 1
    },
    "right": {
      "type": "string",
      "minLength": 1
    },
    "relation": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "expected_from": {
      "type": "string",
      "minLength": 1
    },
    "op": {
      "type": "string",
      "minLength": 1
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reference",
        "text"
      ]
    },
    "expectation": {
      "type": "string",
      "minLength": 1
    },
    "criterion": {
      "type": "string",
      "minLength": 1,
      "description": "Id of the typed criterion in criteria[] that holds your own checkpoint for this author expectation. Write it only when the expectation node carries no literal declaration. The checkpoint is a model judgment, status 未确认, decided by the device run; no independent review is needed and none is started. The criterion's quote, operator and literal (or count, or relation) must equal this assertion's."
    },
    "for": {
      "type": "string",
      "minLength": 1
    },
    "cleanup": {
      "type": "boolean",
      "description": "true 将步骤标为末尾清理段；仅放置非只读、正文未净抵消且未命中 contract.cleanup 运行器自动清理的改配步骤，按产品声明逆序执行对应逆操作，不能从文字猜测；存盘 write memory 等由执行器在收尾时做的命令禁止标为 cleanup:true"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "from": {
      "type": "string",
      "minLength": 1
    },
    "input_register": {
      "type": "string",
      "minLength": 1,
      "description": "The name of a selected cell. The first argument of the command is a template with one {} (or {0}) that the runner replaces whole with the cell; it may stand inside quotes and between known words, e.g. demo use \"K<host>.+005+{}+ksk+RSASHA1+1024\"."
    },
    "author_step_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "description": "本块实现的作者步骤编号列表（可选）：写本条重组记录里作者步骤的 id（items/<n>.json 的 atoms 里 kind 为 action 的 id，如 [\"a2\"] 或 [\"a2\", \"a3\"]），不是序号；保真核对按它确定性定位步骤，写了不存在的编号会在生成保真简报时被点名拒绝；不改变命令语义"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "一行中文，说明这一块做什么（不是抄作者步骤），写进工作簿 D 列；单行，无首尾空白，不以 = 开头。只是说明，不是命令、断言或期望的依据，场景保真核对也看不到它"
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "separator",
        "columns",
        "header"
      ],
      "properties": {
        "format": {
          "type": "string"
        },
        "separator": {
          "type": "string"
        },
        "columns": {
          "type": "integer",
          "minimum": 1
        },
        "header": {
          "type": "boolean"
        }
      }
    },
    "column": {
      "type": "integer",
      "minimum": 1,
      "description": "The 1-based column of a row that the cell is taken from. The cell may be one segment of a longer name (the id inside a file name): then it is only the segment the device generated, and the command that uses it writes the known segments around its one {} placeholder (the writer role, \"取名字的一段\"). The value policy of the executor bounds this one cell, not the assembled command."
    },
    "select": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "row"
          ],
          "properties": {
            "row": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "where"
          ],
          "properties": {
            "where": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "column",
                  "value"
                ],
                "properties": {
                  "column": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ],
      "description": "Which row the cell comes from: a row ordinal, or conditions that each match one column exactly (where; all must hold). Pin every column the plan already knows (host, algorithm, type, size, suffix) with its own condition; no row or more than one row stops the case with the device's words, nothing is guessed."
    }
  },
  "assertion_ops": [
    {
      "op": "found",
      "matching": "escaped_literal"
    },
    {
      "op": "not_found",
      "matching": "escaped_literal"
    },
    {
      "op": "abs_found",
      "matching": "literal"
    },
    {
      "op": "found_times",
      "matching": "escaped_literal"
    }
  ],
  "relations": [
    "same",
    "differs"
  ],
  "criterion_kinds": [
    "literal",
    "count",
    "capture_relation"
  ],
  "obligation_states": [
    "asserted",
    "unmet"
  ],
  "precondition_states": [
    "present",
    "absent",
    "unmet"
  ],
  "responder_kinds": [
    "device",
    "fixture",
    "bed_service",
    "undetermined"
  ],
  "criterion_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "expectation": {
        "type": "string",
        "minLength": 1
      },
      "quote": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "reference",
          "text"
        ]
      },
      "kind": {
        "type": "string",
        "minLength": 1
      },
      "operator": {
        "type": "string",
        "minLength": 1
      },
      "literal": {
        "type": "string",
        "minLength": 1
      },
      "count": {
        "type": "integer",
        "minimum": 1
      },
      "relation": {
        "type": "string",
        "minLength": 1
      },
      "rationale": {
        "type": "string",
        "minLength": 1
      },
      "scope_root": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "id",
      "expectation",
      "quote",
      "kind",
      "operator",
      "rationale",
      "scope_root"
    ]
  },
  "criteria_description": "Checkpoints you chose yourself for author expectations that carry no literal declaration (the author wrote a sentence, not the text to look for). Each entry is a model judgment, status 未确认: the Hub only checks that quote is the author's expectation word for word, that literal is a single line and that the entry equals its assertion; no independent review is needed and none is started, and the device run decides whether the checkpoint holds. quote: the author's expectation, copied verbatim from the original case. literal (or count, or relation): text the device output can contain. rationale: why you chose it. scope_root: the locked root of the command tree. A criteria_review input is read only when one is bound; leave it unbound.",
  "context_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "preconditions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "type": "string",
              "minLength": 1
            },
            "for": {
              "type": "string",
              "minLength": 1
            },
            "established_by": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "quote": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reference": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "reference",
                "text"
              ]
            },
            "missing": {
              "type": "string",
              "minLength": 1
            },
            "next_action": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "state",
            "for",
            "established_by",
            "quote"
          ]
        }
      },
      "causal_links": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "minLength": 1
            },
            "quote": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reference": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "reference",
                "text"
              ]
            }
          },
          "required": [
            "from",
            "to",
            "quote"
          ]
        }
      },
      "responders": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "output": {
              "type": "string",
              "minLength": 1,
              "description": "The id of the observation block this row explains: a blocks[].id of a block that returns device text (OBSERVE_ASSERT, OBSERVE_ONLY, CAPTURE, EXPECT_FROM, or a STEP that declares output). It is never a register name (the register of a CAPTURE or STEP is only the name its text is saved under), never the name of a selected cell and never a device name."
            },
            "kind": {
              "type": "string",
              "minLength": 1,
              "description": "Who answers: device (a frozen environment seat), fixture (an earlier step block of this plan), bed_service (a service declared in the frozen environment inventory) or undetermined (not known yet; also write missing and next_action)."
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "description": "Identifies the answerer, by kind. device: one frozen runtime-profile device identity, exactly one of profile.seats[].device (not an executor object name and not a block id). fixture: the id of an earlier step block of this plan that provides the answer. bed_service: the host of a service of the frozen environment inventory (services[].host). undetermined: any non-empty text."
            },
            "quote": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reference": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "reference",
                "text"
              ],
              "description": "Verbatim source text that grounds the answerer; copy reference and text from the source."
            },
            "missing": {
              "type": "string",
              "minLength": 1,
              "description": "Only for kind=undetermined: the fact that is missing."
            },
            "next_action": {
              "type": "string",
              "minLength": 1,
              "description": "Only for kind=undetermined: the next step that would settle it."
            }
          },
          "required": [
            "output",
            "kind",
            "ref",
            "quote"
          ]
        },
        "description": "Who answers the request a host-command observation sends. One row per host observation block; every row's output must be the id of an observation block of this plan."
      }
    },
    "required": [
      "preconditions",
      "causal_links",
      "responders"
    ]
  },
  "obligation_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "expectation": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "minLength": 1
      },
      "assertions": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "missing": {
        "type": "string",
        "minLength": 1
      },
      "next_action": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "expectation",
      "status",
      "assertions"
    ]
  },
  "review_pack": {
    "id": "case-compile-criterion-review",
    "version": "1.0.1"
  },
  "limits": {
    "blocks": 256,
    "criteria": 128,
    "register_chars": 64
  },
  "runtime_schema": "case-compile.block-runtime@1",
  "expected_sources": [
    "literal",
    "register"
  ],
  "matching_modes": [
    "literal",
    "escaped_literal",
    "exact_text"
  ],
  "raw_output": "raw_text",
  "restore_role": "captured_restore",
  "cell_formats": [
    "delimited",
    "key_value"
  ]
}
