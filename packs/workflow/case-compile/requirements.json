{
  "schema": "requirements@1",
  "requirements": [
    {
      "key": "plan",
      "name": "执行计划",
      "description": "客户端填写受限结构：台架、空 blocks、原名步骤（args 和 keywords）、带逐字引文和 after 步骤号的期望、地址替换表。Hub 只核验槽位，不生成内容；满足后由客户端脚本生成工作簿（任务 2）。步骤自身承担前置与清理：断言要观察的记录先在前部创建；每条改配置的步骤在末尾清理段有逆序对应的逆操作（查询类不需要）；改过地址的接口在清理段恢复原地址。 清理段使用 cleanup:true 显式标记并位于 steps 末尾；对象 ordinal 超过冻结同类型设备容量时整卷拒绝。；另支持显式块计划，块、断言、H/I、前置因果应答者、逐期望义务及捕获恢复规则见包声明；Hub 不解析设备回显。",
      "target": "item",
      "required": true,
      "done_rule": "bookkeeping",
      "layers": [
        "static"
      ],
      "accepted_producer": "judgment",
      "checks": [],
      "error_handling": []
    },
    {
      "key": "contract_methods",
      "name": "步骤调用符合合约",
      "description": "设计 bac0083e：allowed 是启用组合中已开放的子集，每个参数都须有四种角色之一及对应核验；未开的组合换用已开放组合。缺角色的扩展由集成者另开页补角色和检查、重新发布后新运行；模型不能编辑冻结配置；派发方式必须有包内 dispatch-roles 声明，且每个已配置角色均受支持；没有角色可覆盖的组合保持未开，不能将动作字符串冒充 shell。",
      "target": "item",
      "required": true,
      "done_rule": "bookkeeping",
      "layers": [
        "static"
      ],
      "accepted_producer": "fact",
      "checks": [
        "contract_shape"
      ],
      "error_handling": [
