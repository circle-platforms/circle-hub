{
  "schema": "requirements@1",
  "requirements": [
    {
      "key": "plan",
      "name": "执行计划",
      "description": "客户端填写受限结构：台架、空 blocks、原名步骤（args 和 keywords）、带逐字引文和 after 步骤号的期望、地址替换表。Hub 只核验槽位，不生成内容；满足后由客户端脚本生成工作簿（任务 2）",
      "target": "item",
      "required": true,
      "done_rule": "bookkeeping",
      "layers": [
        "static"
      ],
      "accepted_producer": "judgment",
      "checks": [],
      "error_handling": []
    },
    {
      "key": "contract_methods",
      "name": "步骤调用符合合约",
      "description": "启用合约与本轮允许集合的交集；按原始签名核对位置、关键字、必填和脱敏参数，不复制默认值；核对单行值及设备和主机拒绝表；steps 禁止 literal_assertion，工作簿断言只能由生成器从 expects 产生",
      "target": "item",
      "required": true,
      "done_rule": "bookkeeping",
      "layers": [
        "static"
      ],
      "accepted_producer": "fact",
      "checks": [
        "contract_shape"
      ],
      "error_handling": [
        {
          "code": "case-compile.slots_invalid",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.method_forbidden",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.method_not_allowed",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.param_arity",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.param_keyword",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.param_sensitive",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.param_value",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.device_command_denied",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.host_command_denied",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.expect_without_source",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.assertion_in_steps",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.param_unassigned",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.wait_value",
          "action": "repair",
          "max_rounds": 2
        }
      ]
    },
    {
      "key": "bed_addresses",
      "name": "字面地址对得上台架",
      "description": "每个字面地址属于本台架或本血缘分配；设备命令只许该设备接口和服务器地址；替换表一一对应，槽位写最终文字，结论披露替换表",
      "target": "item",
      "required": true,
      "done_rule": "bookkeeping",
      "layers": [
        "static"
      ],
      "accepted_producer": "fact",
      "checks": [
        "bed_addresses"
      ],
      "error_handling": [
        {
          "code": "case-compile.slots_invalid",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.bed_unknown",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.address_off_bed",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.address_wrong_device",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.replacement_invalid",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.replacement_missing",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.expect_without_source",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.param_unassigned",
          "action": "repair",
          "max_rounds": 2
        }
      ]
    },
    {
      "key": "commands_known",
      "name": "命令在目标构建的命令目录里",
      "description": "执行计划里的命令行在目标构建的命令目录（commands@1）里存在，参数类型和取值在范围内（catalog@1 解释器核对）",
      "target": "item",
      "required": true,
      "done_rule": "bookkeeping",
      "layers": [
        "static"
      ],
      "accepted_producer": "fact",
      "checks": [
        "commands_catalog"
      ],
      "error_handling": [
        {
          "code": "core.catalog.not_member",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "core.catalog.arity_mismatch",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "core.catalog.param_out_of_range",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "core.catalog.param_type_mismatch",
          "action": "repair",
          "max_rounds": 2
        }
      ]
    },
    {
      "key": "expected_grounded",
      "name": "期望结果有逐字来源",
      "description": "期望文字是地址替换后逐字引文的片段；after 指向设备命令行或主机 shell，至少一条；原引文仍按原始来源逐字核对",
      "target": "item",
      "required": true,
      "done_rule": "bookkeeping",
      "layers": [
        "static"
      ],
      "accepted_producer": "fact",
      "checks": [
        "expected_sources",
        "expected_quotes"
      ],
      "error_handling": [
        {
          "code": "case-compile.slots_invalid",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.expect_without_source",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.expect_not_in_quote",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.expect_after",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "QUOTE_MISMATCH",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "REFERENCE_UNRESOLVED",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.expect_value",
          "action": "repair",
          "max_rounds": 2
        }
      ]
    }
  ]
}
