{
  "schema": "requirements@1",
  "requirements": [
    {
      "key": "plan",
      "name": "执行计划",
      "description": "客户端填写受限结构：台架、空 blocks、原名步骤（args 和 keywords）、带逐字引文和 after 步骤号的期望、地址替换表。Hub 只核验槽位，不生成内容；满足后由客户端脚本生成工作簿（任务 2）",
      "target": "item",
      "required": true,
      "done_rule": "bookkeeping",
      "layers": [
        "static"
      ],
      "accepted_producer": "judgment",
      "checks": [],
      "error_handling": []
    },
    {
      "key": "contract_methods",
      "name": "步骤调用符合合约",
      "description": "决定 35：合约启用组合全部开放，profile 的组合表只配置参数角色，不另设授权白名单；每个提供参数必须有角色并接受相应筛查。拒绝表、凭据参数禁入、值规则和签名约束照旧，断言只来自 expects",
      "target": "item",
      "required": true,
      "done_rule": "bookkeeping",
      "layers": [
        "static"
      ],
      "accepted_producer": "fact",
      "checks": [
        "contract_shape"
      ],
      "error_handling": [
        {
          "code": "case-compile.slots_invalid",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.method_forbidden",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.param_arity",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.param_keyword",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.param_sensitive",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.param_value",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.device_command_denied",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.host_command_denied",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.expect_without_source",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.assertion_in_steps",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.param_unassigned",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.wait_value",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.host_shell_dynamic",
          "action": "repair",
          "max_rounds": 2
        }
      ]
    },
    {
      "key": "bed_addresses",
      "name": "字面地址对得上台架",
      "description": "决定 35：每个主机字面地址属于本台架任一设备接口或本血缘分配地址；设备命令可以出现本台架其他设备的地址。台架外原地址只能经有原文出处的一一对应 replacements 换入，槽位写最终文字，不由 Hub 改写",
      "target": "item",
      "required": true,
      "done_rule": "bookkeeping",
      "layers": [
        "static"
      ],
      "accepted_producer": "fact",
      "checks": [
        "bed_addresses"
      ],
      "error_handling": [
        {
          "code": "case-compile.slots_invalid",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.bed_unknown",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.address_off_bed",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.replacement_invalid",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.replacement_missing",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.expect_without_source",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.param_unassigned",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.address_notation",
          "action": "repair",
          "max_rounds": 2
        }
      ]
    },
    {
      "key": "commands_known",
      "name": "命令在目标构建的命令目录里",
      "description": "执行计划里的命令行在目标构建的命令目录（commands@1）里存在，参数类型和取值在范围内（catalog@1 解释器核对）",
      "target": "item",
      "required": true,
      "done_rule": "bookkeeping",
      "layers": [
        "static"
      ],
      "accepted_producer": "fact",
      "checks": [
        "commands_catalog"
      ],
      "error_handling": [
        {
          "code": "core.catalog.not_member",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "core.catalog.arity_mismatch",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "core.catalog.param_out_of_range",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "core.catalog.param_type_mismatch",
          "action": "repair",
          "max_rounds": 2
        }
      ]
    },
    {
      "key": "expected_grounded",
      "name": "期望结果有逐字来源",
      "description": "期望文字是地址替换后逐字引文的片段；after 指向设备命令行或主机 shell，至少一条；原引文仍按原始来源逐字核对",
      "target": "item",
      "required": true,
      "done_rule": "bookkeeping",
      "layers": [
        "static"
      ],
      "accepted_producer": "fact",
      "checks": [
        "expected_sources",
        "expected_quotes"
      ],
      "error_handling": [
        {
          "code": "case-compile.slots_invalid",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.expect_without_source",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.expect_not_in_quote",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.expect_after",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "QUOTE_MISMATCH",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "REFERENCE_UNRESOLVED",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "case-compile.expect_value",
          "action": "repair",
          "max_rounds": 2
        }
      ]
    },
    {
      "key": "workbook_verified",
      "name": "工作簿原字节核验",
      "description": "客户端工作簿由独立读取器解释，符合运行器布局、原合约和本轮配置，再从槽位重算字节与绑定原件摘要相同才支持；缺少文件时自动转客户端生成并开始后继核验运行",
      "target": "item",
      "required": true,
      "done_rule": "bookkeeping",
      "layers": [
        "static"
      ],
      "accepted_producer": "fact",
      "checks": [
        "workbook_verified",
        "commands_catalog",
        "expected_quotes"
      ],
      "error_handling": [
        {
          "code": "case-compile.workbook_invalid",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "core.catalog.not_member",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "core.catalog.arity_mismatch",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "core.catalog.param_out_of_range",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "core.catalog.param_type_mismatch",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "QUOTE_MISMATCH",
          "action": "repair",
          "max_rounds": 2
        },
        {
          "code": "REFERENCE_UNRESOLVED",
          "action": "repair",
          "max_rounds": 2
        }
      ]
    }
  ]
}
